# Memory Stress Test

blether "=== Memory Stress Test ==="

# Allocate progressively larger lists
dae allocate_list(size) {
    ken lst = []
    ken i = 0
    whiles i < size {
        shove(lst, i)
        i = i + 1
    }
    gie lst
}

# Test allocation and deallocation in loop
dae allocation_cycle(size, iterations) {
    ken i = 0
    whiles i < iterations {
        ken lst = allocate_list(size)
        # lst goes out of scope here
        i = i + 1
    }
}

# Progressive allocation test
blether "Progressive allocation test:"

ken start = tick()
ken lst = allocate_list(10000)
ken elapsed = tick() - start
blether "  10K elements: " + tae_string(elapsed) + " us, len=" + tae_string(len(lst))

start = tick()
lst = allocate_list(50000)
elapsed = tick() - start
blether "  50K elements: " + tae_string(elapsed / 1000) + " ms, len=" + tae_string(len(lst))

start = tick()
lst = allocate_list(100000)
elapsed = tick() - start
blether "  100K elements: " + tae_string(elapsed / 1000) + " ms, len=" + tae_string(len(lst))

start = tick()
lst = allocate_list(500000)
elapsed = tick() - start
blether "  500K elements: " + tae_string(elapsed / 1000) + " ms, len=" + tae_string(len(lst))

# Release memory
lst = []

# Allocation cycles test
blether ""
blether "Allocation cycle test (allocate and discard):"

start = tick()
allocation_cycle(1000, 100)
elapsed = tick() - start
blether "  100 cycles x 1K elements: " + tae_string(elapsed / 1000) + " ms"

start = tick()
allocation_cycle(10000, 100)
elapsed = tick() - start
blether "  100 cycles x 10K elements: " + tae_string(elapsed / 1000) + " ms"

start = tick()
allocation_cycle(1000, 1000)
elapsed = tick() - start
blether "  1000 cycles x 1K elements: " + tae_string(elapsed / 1000) + " ms"

# Nested list stress
blether ""
blether "Nested list stress:"

dae make_nested_list(depth, width) {
    gin depth <= 0 {
        gie []
    }
    ken result = []
    ken i = 0
    whiles i < width {
        shove(result, make_nested_list(depth - 1, width))
        i = i + 1
    }
    gie result
}

start = tick()
ken nested = make_nested_list(3, 10)  # 10^3 = 1000 leaf lists
elapsed = tick() - start
blether "  Depth 3, width 10 (1K leaves): " + tae_string(elapsed) + " us"

start = tick()
nested = make_nested_list(4, 10)  # 10^4 = 10000 leaf lists
elapsed = tick() - start
blether "  Depth 4, width 10 (10K leaves): " + tae_string(elapsed / 1000) + " ms"

start = tick()
nested = make_nested_list(5, 5)  # 5^5 = 3125 leaf lists
elapsed = tick() - start
blether "  Depth 5, width 5 (3K leaves): " + tae_string(elapsed / 1000) + " ms"

# String memory stress
blether ""
blether "String memory stress:"

dae build_large_string(size) {
    ken result = ""
    ken chunk = "abcdefghij"  # 10 chars
    ken i = 0
    whiles i < size / 10 {
        result = result + chunk
        i = i + 1
    }
    gie result
}

start = tick()
ken s = build_large_string(1000)
elapsed = tick() - start
blether "  Build 1K string: " + tae_string(elapsed) + " us, len=" + tae_string(len(s))

start = tick()
s = build_large_string(5000)
elapsed = tick() - start
blether "  Build 5K string: " + tae_string(elapsed / 1000) + " ms, len=" + tae_string(len(s))

start = tick()
s = build_large_string(10000)
elapsed = tick() - start
blether "  Build 10K string: " + tae_string(elapsed / 1000) + " ms, len=" + tae_string(len(s))

blether ""
blether "=== Memory stress complete ==="
