fetch "games/bogle/shell/replay"

# Story records, path points, locks 3 and 4, story items, the use priority,
# link tags reaching the script (held while talk is open), the levers
# stopping the clock, carry and the story-map replay digest. The test wing
# runs the lab script; reparsed wi another `story` record it runs that one.
dae eng_tic(g, keys) {
    gie tic(g, {"keys": keys, "dx": 0})
}

dae eng_wing(story, extra = "") {
    ken text = replace(read_file("games/bogle/data/storytest.map"), "story lab", "story " + story)
    gie new_game(map_parse(text + extra))
}

# Read a talk box through to its end.
dae eng_read(g) {
    whiles g["talk"] != naething {
        eng_tic(g, 128)
        eng_tic(g, 0)
    }
}

dae eng_actor(g, kind, index = 0) {
    ken n = 0
    fer a in g["actors"] {
        gin a["kind"] == kind {
            gin n == index {
                gie a
            }
            n = n + 1
        }
    }
    gie naething
}

dae eng_at(g, x, y, angle) {
    g["x"] = x * 65536
    g["y"] = y * 65536
    g["angle"] = angle
    g["sector"] = 0
}

dae eng_door(g, sector) {
    fer d in g["doors"] {
        gin d["sector"] == sector {
            gie d
        }
    }
    gie naething
}

ken m = load_map("games/bogle/data/storytest.map")
mak_siccar m["story"] == "lab" an m["ghostlight"] == 64 an len(m["intro"]) == 2
mak_siccar m["require"] == [["keys", 4], ["item", "head"]]
ken legacy = load_map("games/bogle/data/e1m1.map")
mak_siccar legacy["story"] == "" an legacy["require"] == [] an legacy["ghostlight"] == 96 an legacy["intro"] == []
mak_siccar nae bogle_story_map(legacy) an bogle_story_map(m)
ken room = "BOGMAP 1\nv 0 0\nv 1024 0\nv 1024 512\nv 0 512\ns 0 128 1 2 192 0 0 0 1 2 3\nt 1 64 64 0 0\n"
ken paths = new_game(map_parse(room + "t 60 300 64 0 2\nt 60 200 64 0 1\nt 60 400 64 0 3\nt 4 500 64 0 0\nghostlight 200\n"))
mak_siccar len(paths["actors"]) == 1 an len(paths["paths"]) == 3
mak_siccar paths["paths"][0]["x"] == 200 * 65536 an paths["paths"][2]["x"] == 400 * 65536
mak_siccar paths["map"]["ghostlight"] == 200 an nae damage_actor(paths, paths["actors"][0], 10)
blether "ok story records parse, legacy maps keep defaults, path points are no actors"

ken g = eng_wing("forest")
# The brass door (sector 2) refuses without the brass key.
eng_at(g, 240, 56, 0)
eng_tic(g, 128)
mak_siccar g["message"] == "It's lockit. Ye'll be needin' the brass key." an eng_door(g, 2)["state"] == "closed"
eng_tic(g, 0)
# Walking onto the west strip fires link tag 6, the forest's wall gap.
mak_siccar nae g["story"]["gap"] an g["objective"] == "FIND A WAY OOT THE WOOD"
eng_at(g, -64, 64, 0)
g["sector"] = 1
eng_tic(g, 0)
mak_siccar g["story"]["gap"] an g["objective"] == "RING THE BELL" an g["talk"]["lines"] == ["The castle wall was never finished. Ye could hae just walked here."]
mak_siccar bit_an(g["keys"], 4) == 4 an g["message"] == "Brass key: opens the plant room."
eng_read(g)
eng_at(g, 240, 56, 0)
eng_tic(g, 128)
mak_siccar eng_door(g, 2)["state"] == "opening"
blether "ok a walk-over tag reaches the script; the brass key opens lock 3"

eng_tic(g, 0)
eng_at(g, 240, 200, 0)
eng_tic(g, 128)
mak_siccar g["message"] == "RETINA NOT RECOGNISED. ARE YE A SALESMAN?" an eng_door(g, 3)["state"] == "closed"
eng_tic(g, 0)
g["x"] = 400 * 65536
g["y"] = 56 * 65536
g["sector"] = 4
eng_tic(g, 0)
mak_siccar g["items"] == ["head"] an g["message"] == "A heid wi wires. Its ee still blinks."
eng_at(g, 240, 200, 0)
eng_tic(g, 128)
mak_siccar eng_door(g, 3)["state"] == "opening"
blether "ok lock 4 refuses withoot the heid and opens wi it"

# E on a sign on the strip in the tic the gap fires: the sign's box shows
# and the tag waits, queued, until it is read.
g = eng_wing("forest", "t 57 -32 128 0 0\n")
eng_at(g, -64, 128, 0)
g["sector"] = 1
eng_tic(g, 128)
mak_siccar g["talk"]["lines"] == ["TUNNEL STOPS HERE. SORRY. — TT"] an g["fired"] == [6] an nae g["story"]["gap"]
eng_tic(g, 0)
eng_tic(g, 128)
mak_siccar g["talk"] == naething an g["fired"] == [6] an nae g["story"]["gap"]
eng_tic(g, 0)
mak_siccar g["story"]["gap"] an g["fired"] == [] an g["talk"]["lines"][0] == "The castle wall was never finished. Ye could hae just walked here."
blether "ok a tag fired while talk is open waits till it closes"

g = eng_wing("kirkyard")
ken compressor = eng_actor(g, 52)
compressor["x"] = 230 * 65536
eng_at(g, 216, 56, 0)
eng_tic(g, 128)
mak_siccar g["talk"]["lines"][0] == "The compressor wheezes intae life." an g["story"]["air"] an compressor["state"] == "on"
mak_siccar g["objective"] == "PLAY THE TUNE"
eng_tic(g, 0)
eng_read(g)
mak_siccar g["talk"] == naething
g["keys"] = 4
eng_tic(g, 0)
eng_tic(g, 128)
mak_siccar g["message"] == "It's runnin' fine." an eng_door(g, 2)["state"] == "closed"
blether "ok a story thing in reach takes E before the door"

# The kirkyard script has nae use for the computer.
ken computer = eng_actor(g, 50)
compressor["active"] = nae
computer["x"] = 230 * 65536
computer["y"] = 56 * 65536
eng_tic(g, 0)
eng_tic(g, 128)
mak_siccar g["talk"] == naething an eng_door(g, 2)["state"] == "opening"
blether "ok a story thing the script passes on lets E fall through tae the door"

# The lab's three levers, each pulled from in front.
dae eng_pull(g, lever) {
    ken x = lever["x"]
    ken y = lever["y"]
    lever["x"] = 100 * 65536
    lever["y"] = 128 * 65536
    lever["sector"] = 0
    eng_at(g, 64, 128, 0)
    eng_tic(g, 128)
    eng_tic(g, 0)
    lever["x"] = x
    lever["y"] = y
}

g = new_game(load_map("games/bogle/data/storytest.map"))
mak_siccar g["objective"] == "SAVE AILSA" an eng_actor(g, 53, 2) != naething
eng_pull(g, eng_actor(g, 53, 0))
mak_siccar g["story"]["asked"] an g["story"]["levers"] == 1 an g["talk"]["lines"][1] == "TAMPERING DETECTED. DO YOU WISH TO SAVE THE PRINCESS?"
eng_read(g)
mak_siccar g["story"]["countdown"] > 6290 an g["objective"] == "PULL THE THREE LEVERS" an nae g["clock_stop"]
eng_pull(g, eng_actor(g, 53, 1))
mak_siccar g["story"]["levers"] == 2 an g["message"] == "Clunk! 1 tae go." an g["story"]["countdown"] > 0
eng_pull(g, eng_actor(g, 53, 2))
mak_siccar g["story"]["freed"] an g["clock_stop"] an g["story"]["countdown"] == 0 an eng_actor(g, 53, 2)["state"] == "on"
eng_read(g)
ken clock = g["clock"]
eng_tic(g, 0)
eng_tic(g, 0)
mak_siccar g["clock"] == clock an g["story"]["countdown"] == 0 an nae g["failed"]
blether "ok the third lever stops the countdoon and freezes the clock"

g = new_game(load_map("games/bogle/data/storytest.map"))
g["items"] = ["head"]
g["clock"] = 77
g["owned"][2] = aye
ken carry = bogle_front_carry(g)
g["items"] = []
mak_siccar carry["items"] == ["head"] an carry["clock"] == 77
ken fresh = new_game(load_map("games/bogle/data/storytest.map"))
bogle_apply_carry(fresh, carry)
mak_siccar fresh["items"] == ["head"] an fresh["clock"] == 77 an fresh["owned"][2] an fresh["keys"] == 0
carry["items"] = []
mak_siccar fresh["items"] == ["head"]
ken read = bogle_parse_carry("health 40 # wounded\nowned 1 1 0 1\nitems head good_core\nclock 900\n", new_game(load_map("games/bogle/data/storytest.map")))
mak_siccar read["health"] == 40 an read["owned"] == [aye, aye, nae, aye] an read["items"] == ["head", "good_core"] an read["clock"] == 900 an read["mars"] == 0
blether "ok carry takes items and the clock, copied, and reads frae a fixture"

ken fb = bytes(80 * 50)
render(g, fb, 80, 50)
mak_siccar len(split(replay_row(g, fb, 35), " ")) == 3
ken digest = bogle_story_digest(g)
g["story"]["countdown"] = 5
mak_siccar bogle_story_digest(g) != digest
ken old = new_game(load_map("games/bogle/data/e1m1.map"))
render(old, fb, 80, 50)
mak_siccar replay_row(old, fb, 35) == "35 " + tae_string(frame_hash(fb))
blether "ok story maps add a state digest tae each replay row; legacy rows are unchanged"
