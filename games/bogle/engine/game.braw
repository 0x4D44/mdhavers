fetch "games/bogle/engine/trig"
fetch "games/bogle/engine/move"
fetch "games/bogle/engine/render"
fetch "games/bogle/engine/things"
fetch "games/bogle/engine/weapons"
fetch "games/bogle/engine/doors"
fetch "games/bogle/engine/ai"
fetch "games/bogle/engine/curling"

dae new_game(map, play = naething) {
    ken assets = bogle_assets()
    ken z = map["floor_h"][map["start_sector"]] * 65536
    ken gameplay = nae
    gin contains(map, "thing_type") {
        fer kind in map["thing_type"] {
            gin kind >= 10 {
                gameplay = aye
            }
        }
    }
    # Old renderer maps use static decorative doors. A caller can explicitly
    # enable gameplay for a small map containing only enemies or a door.
    gin play != naething {
        gameplay = play
    }
    ken game = {
        "map": map,
        "x": map["start_x"] * 65536,
        "y": map["start_y"] * 65536,
        "z": z,
        "view_z": z + 2686976,
        "vz": 0,
        "angle": bogle_angle(map["start_angle"]),
        "sector": map["start_sector"],
        "seed": 1,
        "tics": 0,
        "sin": load_trig(),
        "cmap": make_cmap(),
        "textures": assets["textures"],
        "sky": assets["sky"],
        "sprite_tex": assets["sprite_tex"],
        "sprite_fullbright": [nae, nae, aye, nae],
        "gameplay": gameplay,
        "health": 100,
        "spirit": 0,
        "keys": 0,
        "mars": 0,
        "powder": 0,
        "puff": 100,
        "owned": [aye, nae, nae, nae],
        "weapon": 1,
        "cooldown": 0,
        "bag_charge": 0,
        "was_fire": nae,
        "was_use": nae,
        "projectiles": [],
        "doors": [],
        "lifts": [],
        "switches": [],
        "triggers": [],
        "secrets": 0,
        "secret_total": 0,
        "speed_tics": 0,
        "won": nae,
        "message": "",
        "hurt_tic": -1000,
        "grin_tic": -1000,
        "bog_slow": nae,
    }
    init_things(game)
    gin gameplay {
        init_doors(game)
    }
    gie game
}

dae tic(g, input) {
    g["sounds"] = []
    gin g["gameplay"] an (g["health"] <= 0 or g["won"]) {
        gie g["sounds"]
    }
    ken keys = input["keys"]
    gin g["gameplay"] {
        fer weapon in 1..5 {
            gin bit_an(keys, 128 * bogle_pow2(weapon)) != 0 an g["owned"][weapon - 1] {
                gin g["weapon"] != weapon {
                    gin g["bag_charge"] > 0 {
                        bogle_emit_sound(g, "pipe_stop")
                    }
                    g["bag_charge"] = 0
                }
                g["weapon"] = weapon
            }
        }
    }
    # Reduce mouse input before subtracting: even either i64 endpoint is safe.
    ken angle = bogle_angle(g["angle"] - bogle_angle(input["dx"]))
    gin bit_an(keys, 16) != 0 {
        angle = angle + 32
    }
    gin bit_an(keys, 32) != 0 {
        angle = angle - 32
    }
    angle = bogle_angle(angle)
    g["angle"] = angle
    gin g["gameplay"] {
        ken use = bit_an(keys, 128) != 0
        ken fresh = use an nae g["was_use"]
        # E on a curling stone kicks it instead of reaching past it.
        gin fresh an curling_use_kick(g) {
            fresh = nae
        }
        doors_tick(g, fresh)
        g["was_use"] = use
        gin g["won"] {
            g["tics"] = g["tics"] + 1
            gie g["sounds"]
        }
    }
    ken forward = 0
    ken sideways = 0
    gin bit_an(keys, 1) != 0 {
        forward = forward + 4
    }
    gin bit_an(keys, 2) != 0 {
        forward = forward - 4
    }
    gin bit_an(keys, 4) != 0 {
        sideways = sideways + 4
    }
    gin bit_an(keys, 8) != 0 {
        sideways = sideways - 4
    }
    gin g["gameplay"] {
        gin g["speed_tics"] > 0 {
            forward = forward * 2
            sideways = sideways * 2
            g["speed_tics"] = g["speed_tics"] - 1
        }
        ken terrain = g["map"]["kind"][g["sector"]]
        gin terrain == 3 or terrain == 4 {
            forward = forward / 2
            sideways = sideways / 2
        }
    }
    ken cosine = bogle_cos(g["sin"], angle)
    ken sine = bogle_sin(g["sin"], angle)
    ken step_x = forward * cosine - sideways * sine
    ken step_y = forward * sine + sideways * cosine
    move_body(g, step_x, step_y)
    gin g["gameplay"] {
        curling_walk_kick(g, step_x, step_y)
    }
    ken floor = g["map"]["floor_h"][g["sector"]] * 65536
    gin g["z"] > floor {
        g["vz"] = g["vz"] - 65536
        g["z"] = g["z"] + g["vz"]
    }
    gin g["z"] <= floor {
        g["z"] = floor
        g["vz"] = 0
    }
    ken target = g["z"] + 2686976
    g["view_z"] = g["view_z"] + (target - g["view_z"]) / 4
    g["tics"] = g["tics"] + 1
    gin g["gameplay"] {
        weapons_tick(g, bit_an(keys, 64) != 0)
        projectiles_tick(g)
        things_tick(g)
        curling_tick(g)
        ai_tick(g)
    }
    gie g["sounds"]
}

dae render(g, fb, w, h) {
    bogle_render(g, fb, w, h)
    gin g["gameplay"] {
        bogle_overlay(g, fb, w, h)
    }
}

# Four selection bits follow movement, fire and use in the replay mask.
dae bogle_pow2(exponent) {
    ken value = 1
    fer i in 0..exponent {
        value = value * 2
    }
    gie value
}
