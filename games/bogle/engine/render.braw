fetch "games/bogle/engine/trig"

fetch "games/bogle/engine/assets"
fetch "games/bogle/engine/fixed"

dae bogle_colour(tex) {
    gie tex % 16 * 16 + 15
}

dae bogle_level(light, distance) {
    gie min(31, max(0, (255 - light) / 8 + distance / 4194304))
}

# Exact truncating value * numerator / denominator for segment clipping.
# At opposite map bounds the unscaled product can exceed i64, even though
# the final intersection fits. Long division keeps its remainder below d.
dae bogle_clip_delta(value, numerator, denominator) {
    gin numerator == 0 or value == 0 {
        gie 0
    }
    ken magnitude = abs(value)
    gin magnitude <= 9223372036854775807 / numerator {
        gie value * numerator / denominator
    }
    ken bit = 1
    whiles bit <= magnitude / 2 {
        bit = bit * 2
    }
    ken quotient = 0
    ken remainder = 0
    whiles bit > 0 {
        quotient = quotient * 2
        remainder = remainder * 2
        gin magnitude / bit % 2 != 0 {
            remainder = remainder + numerator
        }
        quotient = quotient + remainder / denominator
        remainder = remainder % denominator
        bit = bit / 2
    }
    gin value < 0 {
        gie 0 - quotient
    }
    gie quotient
}

dae bogle_solid(fb, w, x, top, bottom, ink) {
    ken at = top * w + x
    whiles top <= bottom {
        bytes_set(fb, at, ink)
        at = at + w
        top = top + 1
    }
}

dae bogle_wrap(value, size) {
    gie (value % size + size) % size
}

dae bogle_texture(g, id) {
    gin id < 0 or id >= len(g["textures"]) {
        id = 0
    }
    gie g["textures"][id]
}

# Wall v is anchored to the complete projected wall before clipping its bands.
dae bogle_wall(fb, w, x, top, bottom, wall_top, wall_bottom, texture, u, offset, level, cmap) {
    ken step = 4194304 / max(1, wall_bottom - wall_top + 1)
    ken v = (top - wall_top) * step + offset * 65536
    ken column = bogle_wrap(u, 64) * 64
    whiles top <= bottom {
        ken colour = bytes_get(texture, column + bogle_wrap(v, 4194304) / 65536)
        bytes_set(fb, top * w + x, bytes_get(cmap, level * 256 + colour))
        v = v + step
        top = top + 1
    }
}

# Ray offsets use the integer sine table to invert tan over the visible octant.
dae bogle_sky_column(g, x, focal) {
    ken offset = abs(x - focal)
    ken lo = 0
    ken hi = 512
    ken angle = 0
    whiles lo <= hi {
        ken mid = (lo + hi) / 2
        gin bogle_sin(g["sin"], mid) * focal <= bogle_cos(g["sin"], mid) * offset {
            angle = mid
            lo = mid + 1
        } ither {
            hi = mid - 1
        }
    }
    gin x > focal {
        angle = 0 - angle
    }
    gie bogle_angle(g["angle"] + angle) / 16
}

dae bogle_sky(fb, w, h, x, top, bottom, texture, column) {
    whiles top <= bottom {
        bytes_set(fb, top * w + x, bytes_get(texture, column * 128 + top * 128 / h))
        top = top + 1
    }
}

# Each row intersects its plane at a distance along this column's world ray.
dae bogle_flat(g, fb, w, h, x, top, bottom, texture, light, delta, scales, ray_x, ray_y, sky, sky_column) {
    gin sky {
        bogle_sky(fb, w, h, x, top, bottom, g["sky"], sky_column)
        gie naething
    }
    whiles top <= bottom {
        ken distance = abs(delta) * scales[top] / 65536
        ken u = bogle_wrap(g["x"] + distance * ray_x / 65536, 4194304) / 65536
        ken v = bogle_wrap(g["y"] + distance * ray_y / 65536, 4194304) / 65536
        ken colour = bytes_get(texture, bogle_wrap(u, 64) * 64 + bogle_wrap(v, 64))
        ken level = bogle_level(light, distance)
        bytes_set(fb, top * w + x, bytes_get(g["cmap"], level * 256 + colour))
        top = top + 1
    }
}

# Things are sorted explicitly so transparent pixels reveal more distant sprites.
dae bogle_sprites(g, fb, w, h, visible, drawsegs, cosine, sine) {
    ken m = g["map"]
    ken sprites = []
    ken actors = []
    ken dynamic = contains(g, "gameplay") an g["gameplay"]
    gin dynamic {
        fer actor in g["actors"] {
            shove(actors, actor)
        }
        gin contains(g, "projectiles") {
            fer projectile in g["projectiles"] {
                gin projectile["active"] {
                    ken kind = 6
                    gin projectile["kind"] == "wail" {
                        kind = 7
                    }
                    gin projectile["kind"] == "sizzle" {
                        kind = 8
                    }
                    shove(actors, {"kind": kind, "sector": projectile["sector"], "x": projectile["x"], "y": projectile["y"], "z": projectile["z"], "active": aye, "state": "idle"})
                }
            }
        }
    } ither {
        fer actor in 0..len(m["thing_type"]) {
            shove(actors, {"kind": m["thing_type"][actor], "sector": m["thing_sector"][actor], "x": m["thing_x"][actor] * 65536, "y": m["thing_y"][actor] * 65536, "z": m["thing_z"][actor] * 65536, "active": aye, "state": "idle"})
        }
    }
    fer actor in actors {
        ken kind = actor["kind"]
        gin nae actor["active"] or nae contains(visible, actor["sector"]) {
            haud
        }
        gin dynamic {
            gin bogle_actor_art(g, actor) == "" {
                haud
            }
        } ither gin kind < 2 or kind > 5 {
            haud
        }
        ken dx = actor["x"] - g["x"]
        ken dy = actor["y"] - g["y"]
        ken z = (dx * cosine + dy * sine) / 65536
        gin z < 16384 {
            haud
        }
        ken view_x = (dx * sine - dy * cosine) / 65536
        ken at = len(sprites)
        shove(sprites, [actor, z, view_x])
        whiles at > 0 an sprites[at - 1][1] < z {
            sprites[at] = sprites[at - 1]
            at = at - 1
        }
        sprites[at] = [actor, z, view_x]
    }
    ken focal = w / 2
    ken horizon = h / 2
    fer sprite in sprites {
        ken actor = sprite[0]
        ken z = sprite[1]
        ken centre = focal + sprite[2] * focal / z
        ken world_height = 6291456
        ken world_half = 2097152
        gin dynamic an actor["kind"] >= 10 an actor["kind"] <= 20 {
            world_height = 2097152
            world_half = 1048576
        }
        gin dynamic an (actor["kind"] == 6 or actor["kind"] == 7) {
            world_height = 1048576
            world_half = 524288
        }
        gin dynamic an actor["kind"] == 8 {
            world_height = 262144
            world_half = 1048576
        }
        ken half = world_half * focal / z
        ken left = centre - half
        ken right = centre + half
        ken bottom = horizon - (actor["z"] - g["view_z"]) * focal / z
        ken top = horizon - (actor["z"] + world_height - g["view_z"]) * focal / z
        gin right <= left or bottom <= top {
            haud
        }
        ken kind = actor["kind"]
        ken texture = g["sprite_tex"][0]
        ken fullbright = nae
        gin dynamic {
            texture = bogle_gameplay_assets()[bogle_actor_art(g, actor)]
            fullbright = kind == 4 or kind == 32
        } ither {
            texture = g["sprite_tex"][kind - 2]
            fullbright = g["sprite_fullbright"][kind - 2]
        }
        ken level = bogle_level(m["light"][actor["sector"]], z)
        ken step = 6291456 / (bottom - top)
        ken ceiling_top = horizon - (m["ceil_h"][actor["sector"]] * 65536 - g["view_z"]) * focal / z
        fer x in max(0, left)..min(w, right) {
            gin dynamic an kind == 4 an x % 2 == 1 {
                haud
            }
            ken clip_top = max(0, max(top, ceiling_top))
            ken clip_bottom = min(h - 1, bottom - 1)
            fer segment in drawsegs {
                gin x >= segment[0] an x <= segment[1] {
                    ken index = x - segment[0]
                    gin segment[6][index] < z {
                        clip_top = max(clip_top, segment[4][index])
                        clip_bottom = min(clip_bottom, segment[5][index])
                    }
                }
            }
            ken u = (x - left) * 64 / (right - left)
            ken v = (clip_top - top) * 6291456 / (bottom - top)
            fer y in clip_top..clip_bottom + 1 {
                ken colour = bytes_get(texture, u * 96 + min(95, v / 65536))
                gin colour != 255 {
                    gin nae fullbright {
                        colour = bytes_get(g["cmap"], level * 256 + colour)
                    }
                    bytes_set(fb, y * w + x, colour)
                }
                v = v + step
            }
        }
    }
}

dae bogle_render(g, fb, w, h) {
    gin w < 2 or h < 2 or w > 1280 or h > 800 or bytes_len(fb) != w * h {
        hurl "Bogle render wants a matching framebuffer frae 2 tae 1280 by 800"
    }
    ken m = g["map"]
    ken vx = m["vx"]
    ken vy = m["vy"]
    ken va = m["wall_v1"]
    ken vb = m["wall_v2"]
    ken floor_h = m["floor_h"]
    ken ceil_h = m["ceil_h"]
    ken portal = m["portal"]
    ken cmap = g["cmap"]
    ken cosine = bogle_cos(g["sin"], g["angle"])
    ken sine = bogle_sin(g["sin"], g["angle"])
    ken px = g["x"]
    ken py = g["y"]
    ken eye = g["view_z"]
    ken focal = w / 2
    ken horizon = h / 2
    ken ytop = []
    ken ybot = []
    ken scales = []
    fer x in 0..w {
        shove(ytop, 0)
        shove(ybot, h - 1)
    }
    fer y in 0..h {
        shove(scales, focal * 65536 / max(1, abs(y - horizon)))
    }
    # Every visible column is filled, including solid fallback at traversal caps.
    fer i in 0..w * h {
        bytes_set(fb, i, 0)
    }
    ken visits = []
    ken entries = []
    fer s in 0..len(floor_h) {
        shove(visits, 0)
        shove(entries, 0)
    }
    entries[g["sector"]] = 1
    ken queue_s = [g["sector"]]
    ken queue_l = [0]
    ken queue_r = [w - 1]
    ken cursor = 0
    ken open_columns = w
    ken visible = []
    ken drawsegs = []
    whiles cursor < len(queue_s) an open_columns > 0 {
        ken s = queue_s[cursor]
        ken window_l = queue_l[cursor]
        ken window_r = queue_r[cursor]
        cursor = cursor + 1
        # Reserve re-entries when queueing, before narrowing the opening.
        # No queued window can then be discarded without filling its pixels.
        visits[s] = visits[s] + 1
        gin visits[s] == 1 {
            shove(visible, s)
        }
        ken first = m["wall_first"][s]
        ken light = m["light"][s]
        ken floor_texture = bogle_texture(g, m["floor_tex"][s])
        ken sky = m["ceil_tex"][s] == -1
        ken ceil_texture = bogle_texture(g, 0)
        gin nae sky {
            ceil_texture = bogle_texture(g, m["ceil_tex"][s])
        }
        fer wall in first..first + m["wall_count"][s] {
            ken ax = vx[va[wall]] * 65536 - px
            ken ay = vy[va[wall]] * 65536 - py
            ken bx = vx[vb[wall]] * 65536 - px
            ken by = vy[vb[wall]] * 65536 - py
            ken za = (ax * cosine + ay * sine) / 65536
            ken zb = (bx * cosine + by * sine) / 65536
            ken xa = (ax * sine - ay * cosine) / 65536
            ken xb = (bx * sine - by * cosine) / 65536
            ken edge_u = vx[vb[wall]] - vx[va[wall]]
            ken edge_v = vy[vb[wall]] - vy[va[wall]]
            ken ua = 0
            ken ub = isqrt(edge_u * edge_u + edge_v * edge_v) * 65536
            ken neighbour = portal[wall]
            # Blocking flags affect collision only; the neighbour stays visible.
            ken can_queue = neighbour >= 0 an entries[neighbour] < 32 an len(queue_s) - cursor < 32
            gin neighbour >= 0 an (za < 16384 or zb < 16384) {
                # The near plane removes wall pixels, but must not erase an open
                # doorway while the eye is crossing it. Intersect the column rays
                # with the actual segment to carry just that aperture onward.
                ken edge_x = vx[vb[wall]] - vx[va[wall]]
                ken edge_y = vy[vb[wall]] - vy[va[wall]]
                ken numerator = ax * edge_y - ay * edge_x
                ken near_l = w
                ken near_r = -1
                fer column in window_l..window_r + 1 {
                    ken ray_x = cosine + sine * (column - focal) / focal
                    ken ray_y = sine - cosine * (column - focal) / focal
                    ken denominator = ray_x * edge_y - ray_y * edge_x
                    gin denominator > 0 an numerator >= 0 an numerator * 4 < denominator {
                        ken along = ax * ray_y - ay * ray_x
                        gin along >= 0 an along <= denominator * 65536 {
                            ken opening_top = horizon - (min(ceil_h[s], ceil_h[neighbour]) * 65536 - eye) * focal / 16384
                            ken opening_bot = horizon - (max(floor_h[s], floor_h[neighbour]) * 65536 - eye) * focal / 16384
                            ken was_open = ytop[column] <= ybot[column]
                            gin was_open an nae can_queue {
                                # Even an aperture nearer than the near plane
                                # must be sealed when traversal cannot continue.
                                ken level = bogle_level(light, 16384)
                                bogle_wall(fb, w, column, ytop[column], ybot[column], ytop[column], ybot[column], bogle_texture(g, m["mid_tex"][wall]), m["x_off"][wall], m["y_off"][wall], level, cmap)
                                ytop[column] = h
                                ybot[column] = -1
                                open_columns = open_columns - 1
                                near_l = min(near_l, column)
                                near_r = max(near_r, column)
                            } ither gin was_open {
                                ytop[column] = max(ytop[column], opening_top)
                                ybot[column] = min(ybot[column], opening_bot)
                                gin ytop[column] > ybot[column] {
                                    open_columns = open_columns - 1
                                } ither {
                                    near_l = min(near_l, column)
                                    near_r = max(near_r, column)
                                }
                            }
                        }
                    }
                }
                gin near_l <= near_r {
                    ken near_top = []
                    ken near_bot = []
                    ken near_depth = []
                    fer column in near_l..near_r + 1 {
                        shove(near_top, ytop[column])
                        shove(near_bot, ybot[column])
                        shove(near_depth, 16384)
                    }
                    shove(drawsegs, [near_l, near_r, 16384, 16384, near_top, near_bot, near_depth])
                    gin can_queue {
                        entries[neighbour] = entries[neighbour] + 1
                        shove(queue_s, neighbour)
                        shove(queue_l, near_l)
                        shove(queue_r, near_r)
                    }
                }
            }
            gin za < 16384 an zb < 16384 {
                haud
            }
            # Integer segment/near-plane intersection before perspective division.
            gin za < 16384 {
                ua = ua + bogle_clip_delta(ub - ua, 16384 - za, zb - za)
                xa = xa + bogle_clip_delta(xb - xa, 16384 - za, zb - za)
                za = 16384
            }
            gin zb < 16384 {
                ub = ub + bogle_clip_delta(ua - ub, 16384 - zb, za - zb)
                xb = xb + bogle_clip_delta(xa - xb, 16384 - zb, za - zb)
                zb = 16384
            }
            ken right = focal + xa * focal / za
            ken left = focal + xb * focal / zb
            # CCW edges face the eye when their first endpoint projects to the right.
            gin left >= right or right < window_l or left > window_r {
                haud
            }
            ken x0 = max(window_l, max(0, left))
            ken x1 = min(window_r, min(w - 1, right - 1))
            gin x0 > x1 {
                haud
            }
            # Reciprocal depth has forty fractional bits, retaining far-wall precision.
            ken inv_l = 1099511627776 / zb
            ken inv_r = 1099511627776 / za
            ken uoz_l = ub * inv_l / 65536
            ken uoz_r = ua * inv_r / 65536
            ken open_l = w
            ken open_r = -1
            ken clip_top = []
            ken clip_bot = []
            ken depths = []
            ken segment_z0 = 0
            ken segment_z1 = 0
            can_queue = neighbour >= 0 an entries[neighbour] < 32 an len(queue_s) - cursor < 32
            fer x in x0..x1 + 1 {
                ken inv = inv_l + (inv_r - inv_l) * (x - left) / (right - left)
                ken z = 1099511627776 / max(1, inv)
                shove(depths, z)
                ken uoz = uoz_l + bogle_clip_delta(uoz_r - uoz_l, x - left, right - left)
                ken u = uoz / max(1, inv) + m["x_off"][wall]
                ken ray_x = cosine + sine * (x - focal) / focal
                ken ray_y = sine - cosine * (x - focal) / focal
                ken sky_column = bogle_sky_column(g, x, focal)
                gin x == x0 {
                    segment_z0 = z
                }
                segment_z1 = z
                ken top = horizon - (ceil_h[s] * 65536 - eye) * focal / z
                ken bottom = horizon - (floor_h[s] * 65536 - eye) * focal / z
                ken old_top = ytop[x]
                ken old_bot = ybot[x]
                gin old_top <= old_bot {
                    bogle_flat(g, fb, w, h, x, old_top, min(old_bot, top - 1), ceil_texture, light, ceil_h[s] * 65536 - eye, scales, ray_x, ray_y, sky, sky_column)
                    bogle_flat(g, fb, w, h, x, max(old_top, bottom + 1), old_bot, floor_texture, light, eye - floor_h[s] * 65536, scales, ray_x, ray_y, nae, sky_column)
                    ken level = bogle_level(light, z)
                    gin neighbour < 0 or nae can_queue {
                        bogle_wall(fb, w, x, max(old_top, top), min(old_bot, bottom), top, bottom, bogle_texture(g, m["mid_tex"][wall]), u, m["y_off"][wall], level, cmap)
                        ytop[x] = h
                        ybot[x] = -1
                        open_columns = open_columns - 1
                    } ither {
                        ken next_top = horizon - (ceil_h[neighbour] * 65536 - eye) * focal / z
                        ken next_bot = horizon - (floor_h[neighbour] * 65536 - eye) * focal / z
                        gin ceil_h[neighbour] < ceil_h[s] {
                            gin sky an m["ceil_tex"][neighbour] == -1 {
                                bogle_sky(fb, w, h, x, max(old_top, top), min(old_bot, next_top - 1), g["sky"], sky_column)
                            } ither {
                                bogle_wall(fb, w, x, max(old_top, top), min(old_bot, next_top - 1), top, bottom, bogle_texture(g, m["upper_tex"][wall]), u, m["y_off"][wall], level, cmap)
                            }
                        }
                        gin floor_h[neighbour] > floor_h[s] {
                            bogle_wall(fb, w, x, max(old_top, next_bot + 1), min(old_bot, bottom), top, bottom, bogle_texture(g, m["lower_tex"][wall]), u, m["y_off"][wall], level, cmap)
                        }
                        ytop[x] = max(old_top, max(top, next_top))
                        ybot[x] = min(old_bot, min(bottom, next_bot))
                        gin ytop[x] > ybot[x] {
                            open_columns = open_columns - 1
                        }
                        gin ytop[x] <= ybot[x] {
                            open_l = min(open_l, x)
                            open_r = max(open_r, x)
                        }
                    }
                }
                shove(clip_top, ytop[x])
                shove(clip_bot, ybot[x])
            }
            shove(drawsegs, [x0, x1, segment_z0, segment_z1, clip_top, clip_bot, depths])
            gin can_queue an open_l <= open_r {
                entries[neighbour] = entries[neighbour] + 1
                shove(queue_s, neighbour)
                shove(queue_l, open_l)
                shove(queue_r, open_r)
            }
        }
    }
    bogle_sprites(g, fb, w, h, visible, drawsegs, cosine, sine)
    g["visible"] = visible
    g["drawsegs"] = drawsegs
}

# Three-by-five glyphs remain legible at the 320x200 reference resolution.
ken bogle_font = {
    "A": "010101111101101",
    "B": "110101110101110",
    "C": "011100100100011",
    "D": "110101101101110",
    "E": "111100110100111",
    "F": "111100110100100",
    "G": "011100101101011",
    "H": "101101111101101",
    "I": "111010010010111",
    "J": "001001001101010",
    "K": "101101110101101",
    "L": "100100100100111",
    "M": "101111111101101",
    "N": "101111111111101",
    "O": "010101101101010",
    "P": "110101110100100",
    "Q": "010101101111011",
    "R": "110101110101101",
    "S": "011100010001110",
    "T": "111010010010010",
    "U": "101101101101111",
    "V": "101101101101010",
    "W": "101101111111101",
    "X": "101101010101101",
    "Y": "101101010010010",
    "Z": "111001010100111",
    "0": "111101101101111",
    "1": "010110010010111",
    "2": "110001010100111",
    "3": "110001010001110",
    "4": "101101111001001",
    "5": "111100110001110",
    "6": "011100111101111",
    "7": "111001010010010",
    "8": "111101111101111",
    "9": "111101111001110",
    "!": "010010010000010",
    ":": "000010000010000",
    "-": "000000111000000",
    ".": "000000000000010",
    "'": "010010000000000",
}

dae bogle_text(fb, w, h, left, top, text, ink, scale) {
    ken x = left
    fer letter in upper(text) {
        gin x + 3 * scale > w {
            brak
        }
        gin contains(bogle_font, letter) {
            ken glyph = bogle_font[letter]
            fer row in 0..5 {
                fer col in 0..3 {
                    gin glyph[row * 3 + col] == "1" {
                        fer yy in 0..scale {
                            fer xx in 0..scale {
                                ken px = x + col * scale + xx
                                ken py = top + row * scale + yy
                                gin px >= 0 an py >= 0 an px < w an py < h {
                                    bytes_set(fb, py * w + px, ink)
                                }
                            }
                        }
                    }
                }
            }
        }
        x = x + 4 * scale
    }
}

dae bogle_overlay(g, fb, w, h) {
    gin nae contains(g, "gameplay") or nae g["gameplay"] {
        gie naething
    }
    ken art = bogle_gameplay_assets()
    ken weapon = g["weapon"]
    ken name = "wpn_sgian_dubh"
    gin weapon == 1 an g["cooldown"] > 0 {
        name = "wpn_sgian_dubh_stab"
    }
    gin weapon == 2 {
        name = "wpn_mars_bar"
        gin g["cooldown"] >= 14 {
            name = "wpn_mars_throw"
        }
    }
    gin weapon == 3 {
        name = "wpn_blunderbuss"
        gin g["cooldown"] >= 24 {
            name = "wpn_blunderbuss_fire"
        }
    }
    gin weapon == 4 {
        name = "wpn_bagpipes_empty"
        gin g["bag_charge"] > 0 {
            name = "wpn_bagpipes_filling"
        }
        gin g["bag_charge"] >= 21 {
            name = "wpn_bagpipes_full"
        }
        gin g["cooldown"] >= 6 {
            name = "wpn_bagpipes_blast"
        }
    }
    ken scale = max(1, min(w / 320, h / 200))
    ken hud = min(h, 16 * scale)
    ken weapon_width = max(1, w * 2 / 5)
    ken weapon_height = max(1, h * 12 / 25)
    ken left = (w - weapon_width) / 2
    ken top = h - hud - weapon_height
    gin g["health"] > 0 {
        ken texture = art[name]
        fer x in 0..weapon_width {
            fer y in 0..weapon_height {
                ken colour = bytes_get(texture, (x * 128 / weapon_width) * 96 + y * 96 / weapon_height)
                ken py = top + y
                gin colour != 255 an py >= 0 {
                    bytes_set(fb, py * w + left + x, colour)
                }
            }
        }
    }
    fer y in h - hud..h {
        fer x in 0..w {
            bytes_set(fb, y * w + x, 2)
        }
    }
    bogle_text(fb, w, h, 3 * scale, h - hud + 2 * scale, "HEALTH " + tae_string(g["health"]), 15, scale)
    bogle_text(fb, w, h, w / 3, h - hud + 2 * scale, "SPIRIT " + tae_string(g["spirit"]), 15, scale)
    ken ammo = "-"
    gin weapon == 2 {
        ammo = tae_string(g["mars"])
    }
    gin weapon == 3 {
        ammo = tae_string(g["powder"])
    }
    gin weapon == 4 {
        ammo = tae_string(g["puff"])
    }
    bogle_text(fb, w, h, w * 2 / 3, h - hud + 2 * scale, "AMMO " + ammo, 15, scale)
    bogle_text(fb, w, h, 3 * scale, h - 6 * scale, "1 KNIFE  2 MARS  3 BUSS  4 PIPES", 13, scale)
    ken message = g["message"]
    gin g["won"] {
        message = "YE'VE ESCAPED THE GATEHOUSE!"
    }
    gin g["health"] <= 0 {
        message = "YE'RE DEID! RESTART TAE TRY AGAIN."
    }
    gin len(message) > 0 {
        bogle_text(fb, w, h, 4 * scale, 4 * scale, message, 15, scale)
    }
}
