fetch "games/bogle/engine/trig"

fetch "games/bogle/engine/assets"
fetch "games/bogle/engine/fixed"
fetch "games/bogle/engine/map"

dae bogle_colour(tex) {
    gie tex % 16 * 16 + 15
}

dae bogle_level(light, distance) {
    gie min(31, max(0, (255 - light) / 8 + distance / 4194304))
}

# Exact truncating value * numerator / denominator for segment clipping.
# At opposite map bounds the unscaled product can exceed i64, even though
# the final intersection fits. Long division keeps its remainder below d.
dae bogle_clip_delta(value, numerator, denominator) {
    gin numerator == 0 or value == 0 {
        gie 0
    }
    ken magnitude = abs(value)
    gin magnitude <= 9223372036854775807 / numerator {
        gie value * numerator / denominator
    }
    ken bit = 1
    whiles bit <= magnitude / 2 {
        bit = bit * 2
    }
    ken quotient = 0
    ken remainder = 0
    whiles bit > 0 {
        quotient = quotient * 2
        remainder = remainder * 2
        gin magnitude / bit % 2 != 0 {
            remainder = remainder + numerator
        }
        quotient = quotient + remainder / denominator
        remainder = remainder % denominator
        bit = bit / 2
    }
    gin value < 0 {
        gie 0 - quotient
    }
    gie quotient
}

dae bogle_solid(fb, w, x, top, bottom, ink) {
    ken at = top * w + x
    whiles top <= bottom {
        bytes_set(fb, at, ink)
        at = at + w
        top = top + 1
    }
}

dae bogle_wrap(value, size) {
    gie (value % size + size) % size
}

dae bogle_texture(g, id) {
    gin id < 0 or id >= len(g["textures"]) {
        id = 0
    }
    gie g["textures"][id]
}

# Wall v is anchored to the complete projected wall before clipping its bands.
dae bogle_wall(fb, w, x, top, bottom, wall_top, wall_bottom, texture, u, offset, level, cmap) {
    ken step = 4194304 / max(1, wall_bottom - wall_top + 1)
    ken v = (top - wall_top) * step + offset * 65536
    ken column = bogle_wrap(u, 64) * 64
    whiles top <= bottom {
        ken colour = bytes_get(texture, column + bogle_wrap(v, 4194304) / 65536)
        bytes_set(fb, top * w + x, bytes_get(cmap, level * 256 + colour))
        v = v + step
        top = top + 1
    }
}

# Ray offsets use the integer sine table to invert tan over the visible octant.
dae bogle_sky_column(g, x, focal) {
    ken offset = abs(x - focal)
    ken lo = 0
    ken hi = 512
    ken angle = 0
    whiles lo <= hi {
        ken mid = (lo + hi) / 2
        gin bogle_sin(g["sin"], mid) * focal <= bogle_cos(g["sin"], mid) * offset {
            angle = mid
            lo = mid + 1
        } ither {
            hi = mid - 1
        }
    }
    gin x > focal {
        angle = 0 - angle
    }
    gie bogle_angle(g["angle"] + angle) / 16
}

dae bogle_sky(fb, w, h, x, top, bottom, texture, column) {
    whiles top <= bottom {
        bytes_set(fb, top * w + x, bytes_get(texture, column * 128 + top * 128 / h))
        top = top + 1
    }
}

# Each row intersects its plane at a distance along this column's world ray.
# Fryer oil shimmer: a texel ripple across u, phase-stepped by rows of v.
ken BOGLE_OIL_RIPPLE = [0, 1, 1, 1, 0, -1, -1, -1]

# Shimmer is -1 for a still flat, else the tic count: the fryer floor's ripple
# travels one step every three tics and the oil drifts one texel every twelve.
dae bogle_flat(g, fb, w, h, x, top, bottom, texture, light, delta, scales, ray_x, ray_y, sky, sky_column, shimmer = -1) {
    gin sky {
        bogle_sky(fb, w, h, x, top, bottom, g["sky"], sky_column)
        gie naething
    }
    whiles top <= bottom {
        ken distance = abs(delta) * scales[top] / 65536
        ken u = bogle_wrap(g["x"] + distance * ray_x / 65536, 4194304) / 65536
        ken v = bogle_wrap(g["y"] + distance * ray_y / 65536, 4194304) / 65536
        gin shimmer >= 0 {
            u = u + BOGLE_OIL_RIPPLE[(v / 4 + shimmer / 3) % 8]
            v = v + shimmer / 12
        }
        ken colour = bytes_get(texture, bogle_wrap(u, 64) * 64 + bogle_wrap(v, 64))
        ken level = bogle_level(light, distance)
        bytes_set(fb, top * w + x, bytes_get(g["cmap"], level * 256 + colour))
        top = top + 1
    }
}

# Render-only animation: no clocks, random draws or simulation writes.
dae bogle_pickup_bob(tics) {
    gie [0, 1, 2, 1, 0, -1, -2, -1][tics / 4 % 8]
}

dae bogle_pickup_glint(tics) {
    gie tics % 70 < 5
}

# Which of eight views the viewer sees: 0 when the actor faces the viewer, rising
# as the actor turns clockwise on screen (its facing swings to the viewer's right).
dae bogle_sprite_octant(table, facing, x, y, viewer_x, viewer_y) {
    ken towards = bogle_atan2(table, viewer_x - x, viewer_y - y)
    gie bogle_angle(facing - towards + 256) / 512
}

# Actor facing for rendering; spawn records without one face angle 0.
dae bogle_actor_facing(actor) {
    gin contains(actor, "facing") {
        gie actor["facing"]
    }
    gin contains(actor, "angle") {
        gie actor["angle"]
    }
    gie 0
}

# Things are sorted explicitly so transparent pixels reveal more distant sprites.
dae bogle_sprites(g, fb, w, h, visible, drawsegs, cosine, sine) {
    ken m = g["map"]
    ken sprites = []
    ken actors = []
    ken dynamic = contains(g, "gameplay") an g["gameplay"]
    gin dynamic {
        fer actor in g["actors"] {
            shove(actors, actor)
        }
        gin contains(g, "projectiles") {
            fer projectile in g["projectiles"] {
                gin projectile["active"] {
                    ken kind = 6
                    gin projectile["kind"] == "wail" {
                        kind = 7
                    }
                    gin projectile["kind"] == "sizzle" {
                        kind = 8
                    }
                    shove(actors, {"kind": kind, "sector": projectile["sector"], "x": projectile["x"], "y": projectile["y"], "z": projectile["z"], "active": aye, "state": "idle"})
                }
            }
        }
    } ither {
        fer actor in 0..len(m["thing_type"]) {
            shove(actors, {"kind": m["thing_type"][actor], "sector": m["thing_sector"][actor], "x": m["thing_x"][actor] * 65536, "y": m["thing_y"][actor] * 65536, "z": m["thing_z"][actor] * 65536, "active": aye, "state": "idle"})
        }
    }
    fer actor in actors {
        ken kind = actor["kind"]
        # A dead rat stays where it fell.
        ken corpse = actor["kind"] == 42 an actor["state"] == "dead"
        gin (nae actor["active"] an nae corpse) or nae contains(visible, actor["sector"]) {
            haud
        }
        gin dynamic {
            gin bogle_actor_art(g, actor) == "" {
                haud
            }
        } ither gin kind < 2 or kind > 5 {
            haud
        }
        ken dx = actor["x"] - g["x"]
        ken dy = actor["y"] - g["y"]
        ken z = (dx * cosine + dy * sine) / 65536
        gin z < 16384 {
            haud
        }
        ken view_x = (dx * sine - dy * cosine) / 65536
        ken at = len(sprites)
        shove(sprites, [actor, z, view_x])
        whiles at > 0 an sprites[at - 1][1] < z {
            sprites[at] = sprites[at - 1]
            at = at - 1
        }
        sprites[at] = [actor, z, view_x]
    }
    ken focal = w / 2
    ken horizon = bogle_horizon(g, w, h)
    fer sprite in sprites {
        ken actor = sprite[0]
        ken z = sprite[1]
        ken centre = focal + sprite[2] * focal / z
        ken world_height = 6291456
        ken world_half = 2097152
        gin dynamic an bogle_is_monster(actor["kind"]) {
            world_height = bogle_actor_height(actor["kind"]) * 65536
            world_half = world_height / 3
        }
        gin dynamic an bogle_is_pickup(actor["kind"]) {
            world_height = 2097152
            world_half = 1048576
        }
        gin dynamic an bogle_is_story_thing(actor["kind"]) {
            world_height = bogle_story_height(actor["kind"]) * 65536
            world_half = world_height / 3
        }
        gin dynamic an (actor["kind"] == 30 or actor["kind"] == 34 or actor["kind"] == 35) {
            world_height = 3145728
            world_half = 1048576
        }
        gin dynamic an (actor["kind"] == 6 or actor["kind"] == 7) {
            world_height = 1048576
            world_half = 524288
        }
        gin dynamic an actor["kind"] == 8 {
            world_height = 262144
            world_half = 1048576
        }
        ken half = world_half * focal / z
        ken left = centre - half
        ken right = centre + half
        ken bob = 0
        gin dynamic an bogle_is_pickup(actor["kind"]) {
            bob = bogle_pickup_bob(g["tics"]) * 65536
        }
        ken bottom = horizon - (actor["z"] + bob - g["view_z"]) * focal / z
        ken top = horizon - (actor["z"] + bob + world_height - g["view_z"]) * focal / z
        gin right <= left or bottom <= top {
            haud
        }
        ken kind = actor["kind"]
        ken texture = g["sprite_tex"][0]
        ken fullbright = nae
        ken mirror = nae
        gin dynamic {
            ken art = bogle_gameplay_assets()
            ken name = bogle_actor_art(g, actor)
            gin contains(art, name + "_a2") {
                ken view = bogle_sprite_view(art, name, bogle_sprite_octant(g["sin"], bogle_actor_facing(actor), actor["x"], actor["y"], g["x"], g["y"]))
                name = view[0]
                mirror = view[1]
            }
            # The falling tree's art topples to the right: mirror it when its
            # fall line runs to the viewer's left.
            gin kind == 45 an actor["state"] != "standing" {
                mirror = actor["dx"] * sine - actor["dy"] * cosine < 0
            }
            texture = art[name]
            fullbright = kind == 4 or kind == 32 or kind == 37 or kind == 39 or kind == 40 or (kind == 47 an actor["state"] == "spark") or (bogle_is_pickup(kind) an bogle_pickup_glint(g["tics"]))
        } ither {
            texture = g["sprite_tex"][kind - 2]
            fullbright = g["sprite_fullbright"][kind - 2]
        }
        ken level = bogle_level(m["light"][actor["sector"]], z)
        ken step = 6291456 / (bottom - top)
        ken ceiling_top = horizon - (m["ceil_h"][actor["sector"]] * 65536 - g["view_z"]) * focal / z
        fer x in max(0, left)..min(w, right) {
            gin dynamic an kind == 4 an x % 2 == 1 {
                haud
            }
            ken clip_top = max(0, max(top, ceiling_top))
            ken clip_bottom = min(h - 1, bottom - 1)
            fer segment in drawsegs {
                gin x >= segment[0] an x <= segment[1] {
                    ken index = x - segment[0]
                    gin segment[6][index] < z {
                        clip_top = max(clip_top, segment[4][index])
                        clip_bottom = min(clip_bottom, segment[5][index])
                    }
                }
            }
            ken u = (x - left) * 64 / (right - left)
            gin mirror {
                u = 63 - u
            }
            ken v = (clip_top - top) * 6291456 / (bottom - top)
            fer y in clip_top..clip_bottom + 1 {
                ken colour = bytes_get(texture, u * 96 + min(95, v / 65536))
                gin colour != 255 {
                    gin nae fullbright {
                        colour = bytes_get(g["cmap"], level * 256 + colour)
                    }
                    bytes_set(fb, y * w + x, colour)
                }
                v = v + step
            }
        }
    }
}

dae bogle_render(g, fb, w, h) {
    gin w < 2 or h < 2 or w > 1280 or h > 800 or bytes_len(fb) != w * h {
        hurl "Bogle render wants a matching framebuffer frae 2 tae 1280 by 800"
    }
    ken m = g["map"]
    ken vx = m["vx"]
    ken vy = m["vy"]
    ken va = m["wall_v1"]
    ken vb = m["wall_v2"]
    ken floor_h = m["floor_h"]
    ken ceil_h = m["ceil_h"]
    ken portal = m["portal"]
    ken cmap = g["cmap"]
    ken cosine = bogle_cos(g["sin"], g["angle"])
    ken sine = bogle_sin(g["sin"], g["angle"])
    ken px = g["x"]
    ken py = g["y"]
    ken eye = g["view_z"]
    ken focal = w / 2
    ken horizon = bogle_horizon(g, w, h)
    ken ytop = []
    ken ybot = []
    ken scales = []
    fer x in 0..w {
        shove(ytop, 0)
        shove(ybot, h - 1)
    }
    fer y in 0..h {
        shove(scales, focal * 65536 / max(1, abs(y - horizon)))
    }
    # Every visible column is filled, including solid fallback at traversal caps.
    fer i in 0..w * h {
        bytes_set(fb, i, 0)
    }
    ken visits = []
    ken entries = []
    fer s in 0..len(floor_h) {
        shove(visits, 0)
        shove(entries, 0)
    }
    entries[g["sector"]] = 1
    ken queue_s = [g["sector"]]
    ken queue_l = [0]
    ken queue_r = [w - 1]
    ken cursor = 0
    ken open_columns = w
    ken visible = []
    ken drawsegs = []
    whiles cursor < len(queue_s) an open_columns > 0 {
        ken s = queue_s[cursor]
        ken window_l = queue_l[cursor]
        ken window_r = queue_r[cursor]
        cursor = cursor + 1
        # Reserve re-entries when queueing, before narrowing the opening.
        # No queued window can then be discarded without filling its pixels.
        visits[s] = visits[s] + 1
        gin visits[s] == 1 {
            shove(visible, s)
        }
        ken first = m["wall_first"][s]
        ken light = m["light"][s]
        ken floor_texture = bogle_texture(g, m["floor_tex"][s])
        ken floor_shimmer = -1
        gin m["kind"][s] == 2 an contains(g, "tics") {
            floor_shimmer = g["tics"]
        }
        ken sky = m["ceil_tex"][s] == -1
        ken ceil_texture = bogle_texture(g, 0)
        gin nae sky {
            ceil_texture = bogle_texture(g, m["ceil_tex"][s])
        }
        fer wall in first..first + m["wall_count"][s] {
            ken ax = vx[va[wall]] * 65536 - px
            ken ay = vy[va[wall]] * 65536 - py
            ken bx = vx[vb[wall]] * 65536 - px
            ken by = vy[vb[wall]] * 65536 - py
            ken za = (ax * cosine + ay * sine) / 65536
            ken zb = (bx * cosine + by * sine) / 65536
            ken xa = (ax * sine - ay * cosine) / 65536
            ken xb = (bx * sine - by * cosine) / 65536
            ken edge_u = vx[vb[wall]] - vx[va[wall]]
            ken edge_v = vy[vb[wall]] - vy[va[wall]]
            ken ua = 0
            ken ub = isqrt(edge_u * edge_u + edge_v * edge_v) * 65536
            ken neighbour = portal[wall]
            # Blocking flags affect collision only; the neighbour stays visible.
            ken can_queue = neighbour >= 0 an entries[neighbour] < 32 an len(queue_s) - cursor < 32
            gin neighbour >= 0 an (za < 16384 or zb < 16384) {
                # The near plane removes wall pixels, but must not erase an open
                # doorway while the eye is crossing it. Intersect the column rays
                # with the actual segment to carry just that aperture onward.
                ken edge_x = vx[vb[wall]] - vx[va[wall]]
                ken edge_y = vy[vb[wall]] - vy[va[wall]]
                ken numerator = ax * edge_y - ay * edge_x
                ken near_l = w
                ken near_r = -1
                fer column in window_l..window_r + 1 {
                    ken ray_x = cosine + sine * (column - focal) / focal
                    ken ray_y = sine - cosine * (column - focal) / focal
                    ken denominator = ray_x * edge_y - ray_y * edge_x
                    gin denominator > 0 an numerator >= 0 an numerator * 4 < denominator {
                        ken along = ax * ray_y - ay * ray_x
                        gin along >= 0 an along <= denominator * 65536 {
                            ken opening_top = horizon - (min(ceil_h[s], ceil_h[neighbour]) * 65536 - eye) * focal / 16384
                            ken opening_bot = horizon - (max(floor_h[s], floor_h[neighbour]) * 65536 - eye) * focal / 16384
                            ken was_open = ytop[column] <= ybot[column]
                            gin was_open an nae can_queue {
                                # Even an aperture nearer than the near plane
                                # must be sealed when traversal cannot continue.
                                ken level = bogle_level(light, 16384)
                                bogle_wall(fb, w, column, ytop[column], ybot[column], ytop[column], ybot[column], bogle_texture(g, m["mid_tex"][wall]), m["x_off"][wall], m["y_off"][wall], level, cmap)
                                ytop[column] = h
                                ybot[column] = -1
                                open_columns = open_columns - 1
                                near_l = min(near_l, column)
                                near_r = max(near_r, column)
                            } ither gin was_open {
                                ytop[column] = max(ytop[column], opening_top)
                                ybot[column] = min(ybot[column], opening_bot)
                                gin ytop[column] > ybot[column] {
                                    open_columns = open_columns - 1
                                } ither {
                                    near_l = min(near_l, column)
                                    near_r = max(near_r, column)
                                }
                            }
                        }
                    }
                }
                gin near_l <= near_r {
                    ken near_top = []
                    ken near_bot = []
                    ken near_depth = []
                    fer column in near_l..near_r + 1 {
                        shove(near_top, ytop[column])
                        shove(near_bot, ybot[column])
                        shove(near_depth, 16384)
                    }
                    shove(drawsegs, [near_l, near_r, 16384, 16384, near_top, near_bot, near_depth])
                    gin can_queue {
                        entries[neighbour] = entries[neighbour] + 1
                        shove(queue_s, neighbour)
                        shove(queue_l, near_l)
                        shove(queue_r, near_r)
                    }
                }
            }
            gin za < 16384 an zb < 16384 {
                haud
            }
            # Integer segment/near-plane intersection before perspective division.
            gin za < 16384 {
                ua = ua + bogle_clip_delta(ub - ua, 16384 - za, zb - za)
                xa = xa + bogle_clip_delta(xb - xa, 16384 - za, zb - za)
                za = 16384
            }
            gin zb < 16384 {
                ub = ub + bogle_clip_delta(ua - ub, 16384 - zb, za - zb)
                xb = xb + bogle_clip_delta(xa - xb, 16384 - zb, za - zb)
                zb = 16384
            }
            ken right = focal + xa * focal / za
            ken left = focal + xb * focal / zb
            # CCW edges face the eye when their first endpoint projects to the right.
            gin left >= right or right < window_l or left > window_r {
                haud
            }
            ken x0 = max(window_l, max(0, left))
            ken x1 = min(window_r, min(w - 1, right - 1))
            gin x0 > x1 {
                haud
            }
            # Reciprocal depth has forty fractional bits, retaining far-wall precision.
            ken inv_l = 1099511627776 / zb
            ken inv_r = 1099511627776 / za
            ken uoz_l = ub * inv_l / 65536
            ken uoz_r = ua * inv_r / 65536
            ken open_l = w
            ken open_r = -1
            ken clip_top = []
            ken clip_bot = []
            ken depths = []
            ken segment_z0 = 0
            ken segment_z1 = 0
            can_queue = neighbour >= 0 an entries[neighbour] < 32 an len(queue_s) - cursor < 32
            fer x in x0..x1 + 1 {
                ken inv = inv_l + (inv_r - inv_l) * (x - left) / (right - left)
                ken z = 1099511627776 / max(1, inv)
                shove(depths, z)
                ken uoz = uoz_l + bogle_clip_delta(uoz_r - uoz_l, x - left, right - left)
                ken u = uoz / max(1, inv) + m["x_off"][wall]
                ken ray_x = cosine + sine * (x - focal) / focal
                ken ray_y = sine - cosine * (x - focal) / focal
                ken sky_column = bogle_sky_column(g, x, focal)
                gin x == x0 {
                    segment_z0 = z
                }
                segment_z1 = z
                ken top = horizon - (ceil_h[s] * 65536 - eye) * focal / z
                ken bottom = horizon - (floor_h[s] * 65536 - eye) * focal / z
                ken old_top = ytop[x]
                ken old_bot = ybot[x]
                gin old_top <= old_bot {
                    bogle_flat(g, fb, w, h, x, old_top, min(old_bot, top - 1), ceil_texture, light, ceil_h[s] * 65536 - eye, scales, ray_x, ray_y, sky, sky_column)
                    bogle_flat(g, fb, w, h, x, max(old_top, bottom + 1), old_bot, floor_texture, light, eye - floor_h[s] * 65536, scales, ray_x, ray_y, nae, sky_column, floor_shimmer)
                    ken level = bogle_level(light, z)
                    gin neighbour < 0 or nae can_queue {
                        bogle_wall(fb, w, x, max(old_top, top), min(old_bot, bottom), top, bottom, bogle_texture(g, m["mid_tex"][wall]), u, m["y_off"][wall], level, cmap)
                        ytop[x] = h
                        ybot[x] = -1
                        open_columns = open_columns - 1
                    } ither {
                        ken next_top = horizon - (ceil_h[neighbour] * 65536 - eye) * focal / z
                        ken next_bot = horizon - (floor_h[neighbour] * 65536 - eye) * focal / z
                        gin ceil_h[neighbour] < ceil_h[s] {
                            gin sky an m["ceil_tex"][neighbour] == -1 {
                                bogle_sky(fb, w, h, x, max(old_top, top), min(old_bot, next_top - 1), g["sky"], sky_column)
                            } ither {
                                bogle_wall(fb, w, x, max(old_top, top), min(old_bot, next_top - 1), top, bottom, bogle_texture(g, m["upper_tex"][wall]), u, m["y_off"][wall], level, cmap)
                            }
                        }
                        gin floor_h[neighbour] > floor_h[s] {
                            bogle_wall(fb, w, x, max(old_top, next_bot + 1), min(old_bot, bottom), top, bottom, bogle_texture(g, m["lower_tex"][wall]), u, m["y_off"][wall], level, cmap)
                        }
                        ytop[x] = max(old_top, max(top, next_top))
                        ybot[x] = min(old_bot, min(bottom, next_bot))
                        gin ytop[x] > ybot[x] {
                            open_columns = open_columns - 1
                        }
                        gin ytop[x] <= ybot[x] {
                            open_l = min(open_l, x)
                            open_r = max(open_r, x)
                        }
                    }
                }
                shove(clip_top, ytop[x])
                shove(clip_bot, ybot[x])
            }
            shove(drawsegs, [x0, x1, segment_z0, segment_z1, clip_top, clip_bot, depths])
            gin can_queue an open_l <= open_r {
                entries[neighbour] = entries[neighbour] + 1
                shove(queue_s, neighbour)
                shove(queue_l, open_l)
                shove(queue_r, open_r)
            }
        }
    }
    bogle_sprites(g, fb, w, h, visible, drawsegs, cosine, sine)
    g["visible"] = visible
    g["drawsegs"] = drawsegs
}

# Three-by-five glyphs remain legible at the 320x200 reference resolution.
ken bogle_font = {
    "A": "010101111101101",
    "B": "110101110101110",
    "C": "011100100100011",
    "D": "110101101101110",
    "E": "111100110100111",
    "F": "111100110100100",
    "G": "011100101101011",
    "H": "101101111101101",
    "I": "111010010010111",
    "J": "001001001101010",
    "K": "101101110101101",
    "L": "100100100100111",
    "M": "101111111101101",
    "N": "101111111111101",
    "O": "010101101101010",
    "P": "110101110100100",
    "Q": "010101101111011",
    "R": "110101110101101",
    "S": "011100010001110",
    "T": "111010010010010",
    "U": "101101101101111",
    "V": "101101101101010",
    "W": "101101111111101",
    "X": "101101010101101",
    "Y": "101101010010010",
    "Z": "111001010100111",
    "0": "111101101101111",
    "1": "010110010010111",
    "2": "110001010100111",
    "3": "110001010001110",
    "4": "101101111001001",
    "5": "111100110001110",
    "6": "011100111101111",
    "7": "111001010010010",
    "8": "111101111101111",
    "9": "111101111001110",
    "!": "010010010000010",
    ":": "000010000010000",
    "-": "000000111000000",
    "+": "000010111010000",
    "/": "001001010100100",
    ".": "000000000000010",
    ",": "000000000010100",
    "'": "010010000000000",
    "?": "111001010000010",
    ">": "100010001010100",
    "(": "010100100100010",
    ")": "010001001001010",
}

dae bogle_text(fb, w, h, left, top, text, ink, scale) {
    ken x = left
    fer letter in upper(text) {
        gin x + 3 * scale > w {
            brak
        }
        gin contains(bogle_font, letter) {
            ken glyph = bogle_font[letter]
            fer row in 0..5 {
                fer col in 0..3 {
                    gin glyph[row * 3 + col] == "1" {
                        fer yy in 0..scale {
                            fer xx in 0..scale {
                                ken px = x + col * scale + xx
                                ken py = top + row * scale + yy
                                gin px >= 0 an py >= 0 an px < w an py < h {
                                    bytes_set(fb, py * w + px, ink)
                                }
                            }
                        }
                    }
                }
            }
        }
        x = x + 4 * scale
    }
}

dae bogle_face_tier(health) {
    gin health > 75 {
        gie "fine"
    }
    gin health > 50 {
        gie "hurt"
    }
    gin health > 25 {
        gie "bad"
    }
    gin health > 0 {
        gie "dire"
    }
    gie "dead"
}

# Recent pain wins over a pickup grin. Idle glances repeat every four seconds.
dae bogle_face(g) {
    ken tier = bogle_face_tier(g["health"])
    gin tier == "dead" {
        gie tier
    }
    ken now = g["tics"]
    gin contains(g, "hurt_tic") an now >= g["hurt_tic"] an now - g["hurt_tic"] < 8 {
        gie "ouch"
    }
    gin contains(g, "grin_tic") an now >= g["grin_tic"] an now - g["grin_tic"] < 18 {
        gie "grin"
    }
    # The healthy glance source has no wounds: retain damage at lower tiers.
    gin tier == "fine" {
        gin now % 140 >= 100 an now % 140 < 114 {
            gie "look_left"
        }
        gin now % 140 >= 120 an now % 140 < 134 {
            gie "look_right"
        }
    }
    gie tier
}

# Column-major indexed sprites shared by the status face and the Kit List.
dae bogle_blit(fb, w, h, texture, tw, th, left, top, width, height, mirror = nae) {
    fer x in max(0, left)..min(w, left + width) {
        ken u = (x - left) * tw / width
        gin mirror {
            u = tw - 1 - u
        }
        fer y in max(0, top)..min(h, top + height) {
            ken colour = bytes_get(texture, u * th + (y - top) * th / height)
            gin colour != 255 {
                bytes_set(fb, y * w + x, colour)
            }
        }
    }
}

# The Tower's HAVE-YE-BEEN-SEEN-O-METER, 0..100: a pure function of the tics
# and the distance to the nearest lit doorway (kind 39). It leaps up near a
# doorway and wobbles; once "Ailsa" has gone off it reads zero for good. It
# reads the game and writes nothing.
dae bogle_seen_meter(g) {
    gin nae bogle_story_map(g["map"]) or g["map"]["story"] != "tower" or contains(g, "meter_off") {
        gie 0
    }
    gin g["story"]["boom"] > 0 {
        gie 0
    }
    ken near = 999999
    fer a in g["actors"] {
        gin a["kind"] == 39 {
            ken dx = (a["x"] - g["x"]) / 65536
            ken dy = (a["y"] - g["y"]) / 65536
            near = min(near, isqrt(dx * dx + dy * dy))
        }
    }
    gin near >= 320 {
        gie 0
    }
    ken wobble = bogle_sin(g["sin"], g["tics"] * 173) * 9 / 65536 + bogle_sin(g["sin"], g["tics"] * 461) * 5 / 65536
    gie max(0, min(100, (320 - near) * 100 / 224 + wobble))
}

# The meter's dial: a red half disc at the view's top right, its needle
# swinging from left (0) to right (100), the name under it.
dae bogle_seen_dial(g, fb, w, h, scale) {
    ken value = bogle_seen_meter(g)
    ken r = max(7, 22 * scale)
    ken cx = w - r - 3 * scale
    ken cy = r + 12 * scale
    fer y in cy - r..cy + 1 {
        fer x in cx - r..cx + r + 1 {
            ken d2 = (x - cx) * (x - cx) + (y - cy) * (y - cy)
            gin d2 <= r * r an x >= 0 an y >= 0 an x < w an y < h {
                ken ink = 88
                gin d2 > (r - scale) * (r - scale) {
                    ink = 15
                }
                bytes_set(fb, y * w + x, ink)
            }
        }
    }
    ken angle = 2048 - value * 2048 / 100
    fer t in 0..r - scale {
        fer side in 0..scale + 1 {
            ken x = cx + bogle_cos(g["sin"], angle) * t / 65536
            ken y = cy - side - bogle_sin(g["sin"], angle) * t / 65536
            gin x >= 0 an y >= 0 an x < w an y < h {
                bytes_set(fb, y * w + x, 0)
            }
        }
    }
    gin w >= 240 {
        ken label = "HAVE-YE-BEEN-SEEN-O-METER"
        bogle_text(fb, w, h, w - len(label) * 4 * scale - 2 * scale, cy + 3 * scale, label, 95, scale)
    }
}

dae bogle_overlay(g, fb, w, h) {
    gin nae contains(g, "gameplay") or nae g["gameplay"] {
        gie naething
    }
    ken art = bogle_gameplay_assets()
    ken weapon = g["weapon"]
    ken name = "wpn_sgian_dubh"
    gin weapon == 1 an g["cooldown"] > 0 {
        name = "wpn_sgian_dubh_stab"
    }
    gin weapon == 2 {
        name = "wpn_mars_bar"
        gin g["cooldown"] >= 14 {
            name = "wpn_mars_throw"
        }
    }
    gin weapon == 3 {
        name = "wpn_blunderbuss"
        gin g["cooldown"] >= 24 {
            name = "wpn_blunderbuss_fire"
        }
    }
    gin weapon == 4 {
        name = "wpn_bagpipes_empty"
        gin g["bag_charge"] > 0 {
            name = "wpn_bagpipes_filling"
        }
        gin g["bag_charge"] >= 21 {
            name = "wpn_bagpipes_full"
        }
        gin g["cooldown"] >= 6 {
            name = "wpn_bagpipes_blast"
        }
    }
    ken scale = max(1, min(w / 320, h / 200))
    ken hud = bogle_hud_height(w, h)
    ken weapon_width = max(1, w * 4 / 15)
    ken weapon_height = max(1, h * 8 / 25)
    ken left = (w - weapon_width) / 2
    ken top = h - hud - weapon_height
    gin g["health"] > 0 {
        ken texture = art[name]
        fer x in 0..weapon_width {
            fer y in 0..weapon_height {
                ken colour = bytes_get(texture, (x * 128 / weapon_width) * 96 + y * 96 / weapon_height)
                ken py = top + y
                gin colour != 255 an py >= 0 {
                    bytes_set(fb, py * w + left + x, colour)
                }
            }
        }
    }
    bogle_hud(g, fb, w, h)
    gin bogle_story_map(g["map"]) an g["map"]["story"] == "tower" {
        # The clone's bang: a brief white flash over the view.
        ken boom = g["story"]["boom"]
        gin boom > 0 an g["tics"] - boom < 6 {
            fer y in 0..h - bogle_hud_height(w, h) {
                fer x in 0..w {
                    gin (x + y) % 2 == 0 {
                        bytes_set(fb, y * w + x, 15)
                    }
                }
            }
        }
        bogle_seen_dial(g, fb, w, h, scale)
    }
    gin bogle_story_map(g["map"]) an contains(g["story"], "countdown") an g["story"]["countdown"] > 0 {
        bogle_countdown(g["story"]["countdown"], fb, w, h, scale)
    }
    gin contains(g, "talk") an g["talk"] != naething {
        bogle_talk_box(g["talk"], fb, w, h, scale)
    }
    ken message = g["message"]
    gin g["won"] {
        message = "YE'VE ESCAPED THE GATEHOUSE!"
        gin bogle_story_map(g["map"]) {
            message = upper(g["map"]["name"]) + " COMPLETE!"
        }
    }
    gin g["health"] <= 0 {
        message = "YE'RE DEID! RESTART TAE TRY AGAIN."
    }
    gin len(message) > 0 {
        bogle_text(fb, w, h, 4 * scale, 4 * scale, message, 15, scale)
    }
}

# The disposal countdown, big and red across the top of the view: M:SS,
# rounded up, under the message line.
dae bogle_countdown(tics, fb, w, h, scale) {
    ken seconds = (tics + 34) / 35
    ken text = tae_string(seconds / 60) + ":" + tae_string(seconds % 60 / 10) + tae_string(seconds % 10)
    ken size = 3 * scale
    gin w < 240 {
        size = 1
    }
    ken label = "DISPOSAL IN"
    bogle_text(fb, w, h, (w - len(label) * 4 * scale) / 2, 12 * scale, label, 95, scale)
    bogle_text(fb, w, h, (w - (len(text) * 4 - 1) * size) / 2, 19 * scale, text, 88, size)
}

# Word-wrap text to rows of at most `columns` letters.
dae bogle_wrap_text(text, columns) {
    ken rows = []
    ken row = ""
    fer word in words(text) {
        gin len(row) > 0 an len(row) + 1 + len(word) > columns {
            shove(rows, row)
            row = ""
        }
        gin len(row) > 0 {
            row = row + " "
        }
        row = row + word
    }
    gin len(row) > 0 {
        shove(rows, row)
    }
    gie rows
}

# The talk box fills the lower third above the status bar: the current line,
# wrapped to four rows, then any choices with a > on the selected one.
dae bogle_talk_box(t, fb, w, h, scale) {
    ken bottom = h - bogle_hud_height(w, h)
    ken top = bottom - (bottom / 3)
    fer y in max(0, top)..bottom {
        fer x in 0..w {
            ken ink = 2
            gin y == top or y == bottom - 1 or x == 0 or x == w - 1 {
                ink = 15
            }
            bytes_set(fb, y * w + x, ink)
        }
    }
    ken rows = []
    gin t["at"] < len(t["lines"]) {
        rows = bogle_wrap_text(t["lines"][t["at"]], max(1, (w - 4 * scale) / (4 * scale)))
    }
    ken y = top + 2 * scale
    fer i in 0..min(4, len(rows)) {
        bogle_text(fb, w, h, 2 * scale, y, rows[i], 15, scale)
        y = y + 6 * scale
    }
    gin t["at"] >= len(t["lines"]) - 1 {
        fer i in 0..len(t["choices"]) {
            ken label = "  " + t["choices"][i]
            ken ink = 13
            gin i == t["sel"] {
                label = "> " + t["choices"][i]
                ink = 15
            }
            bogle_text(fb, w, h, 2 * scale, y, label, ink, scale)
            y = y + 6 * scale
        }
    }
}

# All status text is derived from current state; no objective counter can drift.
# A level script's objective line takes precedence.
dae bogle_hud_objective(g) {
    gin contains(g, "objective") an len(g["objective"]) > 0 {
        gie g["objective"]
    }
    gin bit_an(g["keys"], 1) == 0 {
        gie "FIND AIRN KEY"
    }
    gin bit_an(g["keys"], 2) == 0 {
        gie "FIND SILLER KEY"
    }
    gie "REACH THE GATE"
}

dae bogle_hud_ammo(g, weapon) {
    gin weapon == 2 {
        gie tae_string(g["mars"])
    }
    gin weapon == 3 {
        gie tae_string(g["powder"])
    }
    gin weapon == 4 {
        gie tae_string(g["puff"])
    }
    gie "-"
}

dae bogle_hud_weapon_ink(g, weapon) {
    gin nae g["owned"][weapon - 1] {
        gie 8
    }
    gin g["weapon"] == weapon {
        gie 15
    }
    gie 13
}

# The 3D view ends above the status bar in play, so centre the horizon in
# what is visible; renderer-only maps have no bar and use the full height.
dae bogle_horizon(g, w, h) {
    gin contains(g, "gameplay") an g["gameplay"] {
        gie (h - bogle_hud_height(w, h)) / 2
    }
    gie h / 2
}

# Enemy heights in map units against a 41-unit eye. Sprites are 2:3, so each
# is a third of its height either side of centre.
dae bogle_actor_height(kind) {
    gin kind == 2 {
        gie 60
    }
    gin kind == 3 {
        gie 36
    }
    gin kind == 4 {
        gie 60
    }
    gie 48
}

# Story things stand on the floor; their sprites are 2:3 like the actors.
dae bogle_story_height(kind) {
    gin kind == 42 {
        gie 30
    }
    gin kind == 40 {
        gie 56
    }
    gin kind == 41 {
        gie 40
    }
    gin kind == 51 {
        gie 20
    }
    gin kind == 56 {
        gie 72
    }
    gin kind == 43 {
        gie 60
    }
    gin kind == 45 {
        gie 120
    }
    gin kind == 55 {
        gie 84
    }
    gin kind == 57 {
        gie 60
    }
    gin kind == 47 {
        gie 58
    }
    gin kind == 48 {
        gie 60
    }
    gin kind == 49 {
        gie 96
    }
    gin kind == 50 {
        gie 64
    }
    gin kind == 53 {
        gie 40
    }
    gie 48
}

dae bogle_hud_height(w, h) {
    gin w < 240 or h < 150 {
        gie min(h, 19)
    }
    gie min(h, max(44, h * 44 / 200))
}

# The key panel's two rows, each [art, label, held]: the airn and siller keys,
# or on a story map the keys and things that matter there (the brass key on
# the kirkyard, airn and siller in the cellars, then the heid and the guid
# core while carried).
dae bogle_hud_keys(g) {
    ken classic = [["pick_key_tartan", "AIRN", bit_an(g["keys"], 1) != 0], ["pick_key_silver", "SILLER", bit_an(g["keys"], 2) != 0]]
    gin nae bogle_story_map(g["map"]) {
        gie classic
    }
    ken entries = []
    gin g["map"]["story"] == "kirkyard" {
        shove(entries, ["pick_key_brass", "BRASS", bit_an(g["keys"], 4) != 0])
    } ither gin g["map"]["story"] == "distillery" {
        entries = classic
    }
    gin contains(g["items"], "head") an len(entries) < 2 {
        shove(entries, ["pick_clone_head", "HEID", aye])
    }
    gin contains(g["items"], "good_core") an len(entries) < 2 {
        shove(entries, ["pick_good_core", "CORE", aye])
    }
    gie entries
}

dae bogle_hud(g, fb, w, h) {
    ken top = h - bogle_hud_height(w, h)
    fer y in top..h {
        fer x in 0..w {
            bytes_set(fb, y * w + x, 2)
        }
    }
    ken art = bogle_gameplay_assets()
    ken face = bogle_face(g)
    ken face_name = face
    gin face == "look_left" or face == "look_right" {
        face_name = "look"
    }
    ken faces = bogle_hud_assets()
    gin w < 240 or h < 150 {
        # Compact layout uses native 3x5 letters rather than shrinking text away.
        bogle_text(fb, w, h, 1, top + 1, bogle_hud_objective(g), 15, 1)
        bogle_text(fb, w, h, 1, top + 8, "H" + tae_string(g["health"]), 15, 1)
        bogle_text(fb, w, h, 19, top + 8, "S" + tae_string(g["spirit"]), 13, 1)
        bogle_blit(fb, w, h, faces[face_name], 32, 32, 35, top + 7, 7, 7, face == "look_right")
        bogle_text(fb, w, h, 45, top + 8, "A" + bogle_hud_ammo(g, g["weapon"]), 15, 1)
        fer i in 1..5 {
            bogle_text(fb, w, h, 1 + (i - 1) * 20, top + 14, tae_string(i) + bogle_hud_ammo(g, i), bogle_hud_weapon_ink(g, i), 1)
        }
        ken entries = bogle_hud_keys(g)
        fer i in 0..len(entries) {
            gin entries[i][2] {
                bogle_blit(fb, w, h, art[entries[i][0]], 64, 96, 64 + i * 8, top, 7, 7)
            }
        }
        gie naething
    }
    ken scale = max(1, min(w / 320, h / 200))
    # Draw at reference coordinates with integer scaling for larger buffers.
    bogle_text(fb, w, h, 4 * scale, top + 2 * scale, bogle_hud_objective(g), 15, scale)
    bogle_blit(fb, w, h, art["pick_haggis_plate"], 64, 96, 3 * scale, top + 9 * scale, 18 * scale, 24 * scale)
    bogle_text(fb, w, h, 24 * scale, top + 10 * scale, "HEALTH", 13, scale)
    bogle_text(fb, w, h, 24 * scale, top + 18 * scale, tae_string(g["health"]), 15, 2 * scale)
    bogle_blit(fb, w, h, art["pick_shortbread"], 64, 96, 76 * scale, top + 9 * scale, 18 * scale, 24 * scale)
    bogle_text(fb, w, h, 97 * scale, top + 10 * scale, "SPIRIT", 13, scale)
    bogle_text(fb, w, h, 97 * scale, top + 18 * scale, tae_string(g["spirit"]), 15, 2 * scale)
    bogle_blit(fb, w, h, faces[face_name], 32, 32, 143 * scale, top + 9 * scale, 26 * scale, 26 * scale, face == "look_right")
    gin contains(faces["missing"], face_name) {
        bogle_text(fb, w, h, 147 * scale, top + 19 * scale, "FACE", 15, scale)
    }
    bogle_text(fb, w, h, 178 * scale, top + 10 * scale, "AMMO", 13, scale)
    bogle_text(fb, w, h, 178 * scale, top + 18 * scale, bogle_hud_ammo(g, g["weapon"]), 15, 2 * scale)
    fer i in 2..5 {
        ken row = top + (9 + (i - 2) * 9) * scale
        bogle_text(fb, w, h, 225 * scale, row, ["MARS", "SHOT", "PUFF"][i - 2] + " " + bogle_hud_ammo(g, i), bogle_hud_weapon_ink(g, i), scale)
    }
    ken entries = bogle_hud_keys(g)
    fer i in 0..len(entries) {
        ken row = top + (8 + i * 14) * scale
        ken ink = 8
        gin entries[i][2] {
            ink = 15
            bogle_blit(fb, w, h, art[entries[i][0]], 64, 96, 282 * scale, row - 2 * scale, 10 * scale, 14 * scale)
        }
        bogle_text(fb, w, h, 296 * scale, row + 3 * scale, entries[i][1], ink, scale)
    }
    fer i in 1..5 {
        ken x = (4 + (i - 1) * 79) * scale
        ken ink = bogle_hud_weapon_ink(g, i)
        gin g["weapon"] == i {
            fer xx in x..min(w, x + 73 * scale) {
                bytes_set(fb, (top + 35 * scale) * w + xx, 15)
            }
        }
        bogle_text(fb, w, h, x, top + 37 * scale, ["1 SGIAN-DUBH", "2 MARS BARS", "3 BUSS", "4 BAGPIPES"][i - 1], ink, scale)
    }
}
