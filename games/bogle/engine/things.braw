fetch "games/bogle/engine/move"
fetch "games/bogle/engine/kinds"

# Mutable game actors are separate from immutable map spawn records.
# Path points (type 60) are waypoints, not actors.
dae init_things(g) {
    g["actors"] = []
    g["sounds"] = []
    g["bog_spawn_timer"] = 350
    g["bog_slow"] = nae
    # Curling stones by thing index (naething elsewhere): move.braw reads their
    # live positions, and curling.braw their glide.
    g["stones"] = []
    g["paths"] = []
    ken m = g["map"]
    gin nae contains(m, "thing_type") {
        gie naething
    }
    fer i in 0..len(m["thing_type"]) {
        ken kind = m["thing_type"][i]
        shove(g["stones"], naething)
        gin kind == 60 {
            # Ordered by flags; equal flags keep map order.
            ken point = {"x": m["thing_x"][i] * 65536, "y": m["thing_y"][i] * 65536, "order": m["thing_flags"][i]}
            ken at = len(g["paths"])
            shove(g["paths"], point)
            whiles at > 0 an g["paths"][at - 1]["order"] > point["order"] {
                g["paths"][at] = g["paths"][at - 1]
                at = at - 1
            }
            g["paths"][at] = point
        } ither gin kind != 1 {
            ken hp = 1
            ken state = "idle"
            gin kind == 2 {
                hp = 80
                state = "patrol"
            }
            gin kind == 3 {
                hp = 1
                state = "dormant"
            }
            gin kind == 4 {
                hp = 60
                state = "chase"
            }
            gin kind == 5 {
                hp = 200
                state = "chase"
            }
            # The rat lurks until it sees the player; the deer patrols like
            # the gamekeeper; thistles hide as tufts and trees stand until
            # they fall.
            gin kind >= 42 an kind <= 45 {
                hp = [12, 50, 30, 1][kind - 42]
                state = ["idle", "patrol", "tuft", "standing"][kind - 42]
            }
            gin kind == 49 {
                hp = 450
                state = "chase"
            }
            shove(g["actors"], {
                "x": m["thing_x"][i] * 65536,
                "y": m["thing_y"][i] * 65536,
                "z": (m["thing_z"][i] + actor_mount_height(kind)) * 65536,
                "sector": m["thing_sector"][i],
                "angle": m["thing_angle"][i],
                "facing": m["thing_angle"][i],
                "kind": kind,
                "flags": m["thing_flags"][i],
                "thing": i,
                "health": hp,
                "state": state,
                "timer": 0,
                "seen_player": nae,
                "charge_tics": 0,
                "vx": 0,
                "vy": 0,
                "dx": 0,
                "dy": 0,
                "active": aye,
                "svx": 0,
                "svy": 0,
                "kick_tic": -1000,
            })
            gin kind == 36 {
                g["stones"][i] = g["actors"][len(g["actors"]) - 1]
            }
            gin kind == 44 or kind == 45 {
                ken plant = g["actors"][len(g["actors"]) - 1]
                plant["far"] = 0
                plant["still"] = 0
            }
            gin kind == 40 {
                ken wullie = g["actors"][len(g["actors"]) - 1]
                wullie["state"] = "walk"
                wullie["path"] = 0
                wullie["seen"] = 0
            }
        }
    }
}

# Wall dressing hangs with its centre at eye height (48 units).
dae actor_mount_height(kind) {
    gin kind == 30 or kind == 34 or kind == 35 {
        gie 24
    }
    gie 0
}

# Distances in map units keep the squared products safely inside i64.
dae actor_distance(x, y, tx, ty) {
    ken dx = (tx - x) / 65536
    ken dy = (ty - y) / 65536
    gie isqrt(dx * dx + dy * dy)
}

dae hurt_player(g, damage) {
    gin damage <= 0 or g["health"] <= 0 {
        gie naething
    }
    ken absorbed = damage
    gin absorbed > g["spirit"] {
        absorbed = g["spirit"]
    }
    g["spirit"] = g["spirit"] - absorbed
    g["health"] = g["health"] - damage + absorbed
    g["hurt_tic"] = g["tics"]
    g["message"] = "Ya wee scunner!"
    bogle_emit_sound(g, "oof")
    gin g["health"] < 0 {
        g["health"] = 0
    }
}

dae damage_actor(g, actor, damage) {
    gin actor["active"] an actor["kind"] == 40 {
        g["message"] = "Ye cannae shoot Wullie!"
    }
    gin nae actor["active"] or damage <= 0 or nae bogle_is_monster(actor["kind"]) or nae bogle_hittable(actor) {
        gie nae
    }
    gin actor["kind"] == 4 an g["map"]["light"][actor["sector"]] <= bogle_ghostlight(g["map"]) {
        gie nae
    }
    gin actor["kind"] == 5 {
        damage = 1
    }
    # The contraption takes double while it vents, and nothing once slumped.
    gin actor["kind"] == 49 {
        gin actor["state"] == "slumped" {
            gie nae
        }
        gin actor["state"] == "vent" {
            damage = damage * 2
        }
    }
    actor["health"] = actor["health"] - damage
    gin actor["health"] <= 0 an actor["kind"] == 49 {
        # It slumps where it stands, still in the way, its core sparkin'.
        actor["health"] = 0
        actor["state"] = "slumped"
        bogle_emit_sound(g, "steam")
        gie aye
    }
    gin actor["health"] <= 0 {
        actor["health"] = 0
        actor["active"] = nae
        actor["state"] = "dead"
        # Mark inactive before recursing so two adjacent haggises cannot loop.
        gin actor["kind"] == 3 {
            actor["state"] = "exploded"
            bogle_emit_sound(g, "explosion")
            splash_damage(g, actor["x"], actor["y"], actor["z"], actor["sector"], 96, 60, actor)
        }
    }
    gie aye
}

# Story maps may set the light at or below which the ghost cannot be hurt.
dae bogle_ghostlight(m) {
    gin contains(m, "ghostlight") {
        gie m["ghostlight"]
    }
    gie 96
}

# A shot shoves a curling stone along the 16.16 unit direction (ux, uy) by
# damage/8 units a tic: a 20-damage sgian dubh nudges it 2.5, a full
# blunderbuss (seven 8-damage pellets) 7, against a kick's 10.
dae stone_shove(g, s, ux, uy, damage) {
    s["svx"] = s["svx"] + ux * damage / 8
    s["svy"] = s["svy"] + uy * damage / 8
    bogle_emit_sound(g, "stone_clack")
}

# Splash also pushes curling stones in sight away from its centre, falling off
# like the damage. skip_stone is the thing index of a stone the blast's
# projectile already struck directly.
dae splash_damage(g, x, y, z, sector, radius, damage, source, skip_stone = -1) {
    gin radius <= 0 or damage <= 0 {
        gie naething
    }
    ken distance = actor_distance(x, y, g["x"], g["y"])
    gin distance < radius an bogle_sight(g, x, y, z + 24 * 65536, sector, g["x"], g["y"], g["z"] + 24 * 65536, g["sector"]) {
        hurt_player(g, damage * (radius - distance) / radius)
    }
    fer a in g["actors"] {
        gin a["active"] an bogle_hittable(a) {
            distance = actor_distance(x, y, a["x"], a["y"])
            gin distance < radius an bogle_sight(g, x, y, z + 24 * 65536, sector, a["x"], a["y"], a["z"] + 24 * 65536, a["sector"]) {
                damage_actor(g, a, damage * (radius - distance) / radius)
            }
        }
    }
    fer s in g["stones"] {
        gin s != naething an s["thing"] != skip_stone {
            ken dx = (s["x"] - x) / 65536
            ken dy = (s["y"] - y) / 65536
            gin abs(dx) < radius an abs(dy) < radius {
                distance = isqrt(dx * dx + dy * dy)
                gin distance > 0 an distance < radius an bogle_sight(g, x, y, z + 24 * 65536, sector, s["x"], s["y"], s["z"] + 16 * 65536, s["sector"]) {
                    stone_shove(g, s, dx * 65536 / distance, dy * 65536 / distance, damage * (radius - distance) / radius)
                }
            }
        }
    }
}

# Both ordinary walking and knockback share exactly the player's wall slide.
dae actor_move(g, a, dx, dy) {
    ken body = {
        "map": g["map"],
        "x": a["x"],
        "y": a["y"],
        "z": a["z"],
        "vz": 0,
        "sector": a["sector"],
        "ignore_steps": a["kind"] == 5,
        "no_drop": a["kind"] == 2 or a["kind"] == 3 or a["kind"] == 42 or a["kind"] == 43,
    }
    gin contains(g, "stones") {
        body["stones"] = g["stones"]
    }
    move_body(body, dx, dy)
    # Walking actors remain grounded when a portal leads to a lower floor.
    gin a["kind"] != 4 {
        body["z"] = g["map"]["floor_h"][body["sector"]] * 65536
    }
    ken moved = body["x"] - a["x"] == dx an body["y"] - a["y"] == dy
    fer field in ["x", "y", "z", "sector"] {
        a[field] = body[field]
    }
    gie moved
}

dae actor_pickup(g, a) {
    ken kind = a["kind"]
    ken messages = {
        10: "Oatcake: +10 health, up tae 100.",
        11: "Haggis plate: +50 health, up tae 100.",
        12: "Wee juice: +15 health, up tae 100.",
        13: "Juice bottle: full health, double speed for 3 seconds.",
        14: "Shortbread: spirit filled tae 100.",
        15: "Mars box: 5 throws, unlocks Mars bars.",
        16: "Powder an shot: +5 blunderbuss shots.",
        17: "Blunderbuss unlocked, wi 5 shots.",
        18: "Bagpipes unlocked: haud fire, then let gae!",
        19: "Airn key: opens the gallery door.",
        20: "Siller key: opens the battlement door.",
        22: "Brass key: opens the plant room.",
        23: "A heid wi wires. Its ee still blinks.",
        24: "The guid core. It hums a wee tune.",
    }
    g["message"] = messages[kind]
    gin kind == 10 {
        g["health"] = g["health"] + 10
    }
    gin kind == 11 {
        g["health"] = g["health"] + 50
    }
    gin kind == 12 {
        g["health"] = g["health"] + 15
    }
    gin kind == 13 {
        g["health"] = 100
        g["speed_tics"] = 105
    }
    gin g["health"] > 100 {
        g["health"] = 100
    }
    gin kind == 14 {
        g["spirit"] = 100
    }
    gin kind == 15 {
        g["mars"] = g["mars"] + 5
        g["owned"][1] = aye
    }
    gin kind == 16 {
        g["powder"] = g["powder"] + 5
    }
    gin kind == 17 {
        g["owned"][2] = aye
        g["powder"] = g["powder"] + 5
    }
    gin kind == 18 {
        g["owned"][3] = aye
    }
    gin kind == 19 {
        g["keys"] = bit_or(g["keys"], 1)
    }
    gin kind == 20 {
        g["keys"] = bit_or(g["keys"], 2)
    }
    gin kind == 22 {
        g["keys"] = bit_or(g["keys"], 4)
    }
    # Story items travel in the carry from level to level.
    gin kind == 23 or kind == 24 {
        ken item = "head"
        gin kind == 24 {
            item = "good_core"
        }
        gin nae contains(g["items"], item) {
            shove(g["items"], item)
        }
    }
    gin kind == 15 or (kind >= 17 an kind <= 20) or kind >= 22 {
        g["grin_tic"] = g["tics"]
    }
    a["active"] = nae
    bogle_emit_sound(g, "pickup")
}

dae things_tick(g) {
    fer a in g["actors"] {
        gin a["active"] {
            gin a["vx"] != 0 or a["vy"] != 0 {
                actor_move(g, a, a["vx"], a["vy"])
                a["vx"] = a["vx"] / 2
                a["vy"] = a["vy"] / 2
            }
            gin bogle_is_pickup(a["kind"]) an actor_distance(g["x"], g["y"], a["x"], a["y"]) < 24 an abs(g["z"] - a["z"]) < 32 * 65536 an bogle_sight(g, g["x"], g["y"], g["z"] + 24 * 65536, g["sector"], a["x"], a["y"], a["z"] + 24 * 65536, a["sector"]) {
                actor_pickup(g, a)
            }
        }
    }
    g["bog_slow"] = nae
    gin contains(g["map"], "kind") {
        ken kind = g["map"]["kind"][g["sector"]]
        g["bog_slow"] = kind == 3 or kind == 4
        gin kind == 3 {
            g["bog_spawn_timer"] = g["bog_spawn_timer"] - 1
            gin g["bog_spawn_timer"] <= 0 {
                ken populated = nae
                fer a in g["actors"] {
                    gin a["active"] an a["kind"] == 5 an a["sector"] == g["sector"] {
                        populated = aye
                    }
                }
                gin nae populated {
                    shove(g["actors"], {
                        "x": g["x"],
                        "y": g["y"],
                        "z": g["z"],
                        "sector": g["sector"],
                        "angle": game_random(g) % 4096,
                        "facing": 0,
                        "kind": 5,
                        "health": 200,
                        "state": "chase",
                        "timer": 0,
                        "vx": 0,
                        "vy": 0,
                        "dx": 0,
                        "dy": 0,
                        "active": aye,
                    })
                }
                g["bog_spawn_timer"] = 350
            }
        }
        gin g["tics"] % 35 == 0 an g["z"] <= g["map"]["floor_h"][g["sector"]] * 65536 {
            gin kind == 2 {
                hurt_player(g, 10)
            }
            gin kind == 3 {
                hurt_player(g, 2)
            }
        }
    }
}

# Events are an output of the deterministic tic, never input to simulation.
# Coalesce identical cues within a tic (several pickups or adjacent swarms).
dae bogle_emit_sound(g, cue) {
    gin nae contains(g["sounds"], cue) {
        shove(g["sounds"], cue)
    }
}
