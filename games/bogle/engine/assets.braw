dae bogle_actor_art(g, actor) {
    ken kind = actor["kind"]
    ken state = actor["state"]
    ken tick = g["tics"] / 6 % 2
    ken name = ""
    gin kind == 2 {
        name = "spr_gamekeeper_idle"
        gin state == "chase" or state == "walk" or state == "patrol" {
            name = "spr_gamekeeper_walk" + tae_string(tick + 1)
        }
        gin state == "charge" or state == "windup" {
            name = "spr_gamekeeper_charge"
        }
        gin state == "pain" or state == "stunned" {
            name = "spr_gamekeeper_pain"
        }
        gin state == "dead" or state == "death" {
            name = "spr_gamekeeper_death2"
        }
    } ither gin kind == 3 {
        name = "spr_haggis_idle"
        gin state == "chase" or state == "walk" {
            name = "spr_haggis_walk" + tae_string(tick + 1)
        }
        gin state == "dead" or state == "death" or state == "explode" {
            name = "spr_haggis_boom" + tae_string(tick + 1)
        }
    } ither gin kind == 4 {
        name = "spr_tartan_ghost_idle"
        gin tick == 1 {
            name = "spr_tartan_ghost_float2"
        }
        gin state == "pain" or state == "stunned" {
            name = "spr_tartan_ghost_pain"
        }
        gin state == "attack" or state == "wail" {
            name = "spr_tartan_ghost_wail"
        }
        gin state == "dead" or state == "death" {
            name = "spr_tartan_ghost_death"
        }
    } ither gin kind == 5 {
        name = "spr_midges_idle"
        gin tick == 1 {
            name = "spr_midges_idle2"
        }
    } ither gin kind == 6 {
        name = "prj_mars_bar"
    } ither gin kind == 7 {
        name = "prj_wail"
    } ither gin kind == 8 {
        name = "prj_mars_splat"
    } ither gin kind >= 10 an kind <= 21 {
        name = ["pick_oatcake", "pick_haggis_plate", "pick_girder_juice", "pick_girder_bottle", "pick_shortbread", "pick_mars_box", "pick_powder_shot", "pick_blunderbuss", "pick_bagpipes", "pick_key_tartan", "pick_key_silver", "dec_banner"][kind - 10]
    } ither gin kind >= 30 an kind <= 36 {
        name = ["dec_stag_head", "dec_armour", "dec_brazier", "dec_thistle_pot", "dec_cow_portrait", "dec_banner", "dec_curling_stone"][kind - 30]
    }
    gie name
}
