fetch "games/bogle/engine/weapons"
fetch "games/bogle/engine/things"
fetch "games/bogle/engine/map"
fetch "games/bogle/engine/trig"

# Return an integer fixed velocity, preserving sub-unit differences near targets.
dae actor_towards(a, x, y, speed) {
    ken dx = x - a["x"]
    ken dy = y - a["y"]
    ken distance = actor_distance(a["x"], a["y"], x, y)
    gin distance < 1 {
        gie [0, 0]
    }
    gie [dx * speed / distance / 65536, dy * speed / distance / 65536]
}

# Facing is render-only state: it never feeds back into simulation.
dae actor_face(g, a, dx, dy) {
    gin dx != 0 or dy != 0 {
        a["facing"] = bogle_atan2(g["sin"], dx, dy)
    }
}

# Walk one step only if the whole step is free; a refused step leaves the
# actor where it was, so a chase can probe several directions in one tic.
dae actor_try(g, a, dx, dy) {
    ken saved = [a["x"], a["y"], a["z"], a["sector"]]
    gin actor_move(g, a, dx, dy) {
        gie aye
    }
    a["x"] = saved[0]
    a["y"] = saved[1]
    a["z"] = saved[2]
    a["sector"] = saved[3]
    gie nae
}

# Eight chase directions, 512 angle units apart: 0 east, 2 north, 4 west, 6 south.
dae actor_try_dir(g, a, dir, speed) {
    ken dx = bogle_cos(g["sin"], dir * 512) * speed / 65536
    ken dy = bogle_sin(g["sin"], dir * 512) * speed / 65536
    gin actor_try(g, a, dx, dy) {
        a["movedir"] = dir
        actor_face(g, a, dx, dy)
        gie aye
    }
    gie nae
}

# Doom's P_NewChaseDir: the diagonal towards the target, then each axis with
# the larger delta first, then the old direction, then a seeded scan of the
# rest; turning round comes last. A new direction is held for a few tics.
dae actor_new_chase_dir(g, a, tx, ty, speed) {
    ken olddir = a["movedir"]
    ken turnaround = -1
    gin olddir >= 0 {
        turnaround = (olddir + 4) % 8
    }
    ken deltax = (tx - a["x"]) / 65536
    ken deltay = (ty - a["y"]) / 65536
    ken d1 = -1
    ken d2 = -1
    gin deltax > 10 {
        d1 = 0
    } ither gin deltax < -10 {
        d1 = 4
    }
    gin deltay > 10 {
        d2 = 2
    } ither gin deltay < -10 {
        d2 = 6
    }
    a["movecount"] = game_random(g) % 16
    gin d1 >= 0 an d2 >= 0 {
        ken diagonal = 7
        gin d1 == 0 an d2 == 2 {
            diagonal = 1
        } ither gin d1 == 4 an d2 == 2 {
            diagonal = 3
        } ither gin d1 == 4 {
            diagonal = 5
        }
        gin diagonal != turnaround an actor_try_dir(g, a, diagonal, speed) {
            gie aye
        }
    }
    gin abs(deltay) > abs(deltax) {
        ken swap = d1
        d1 = d2
        d2 = swap
    }
    fer dir in [d1, d2, olddir] {
        gin dir >= 0 an dir != turnaround an actor_try_dir(g, a, dir, speed) {
            gie aye
        }
    }
    # Doom scans the rest from east; fanning out from the target's octant
    # instead keeps the detour hugging the obstruction. A seeded coin picks
    # which side of the target to try first.
    ken target = (bogle_atan2(g["sin"], tx - a["x"], ty - a["y"]) + 256) / 512 % 8
    ken side = 1
    gin game_random(g) % 2 == 1 {
        side = 7
    }
    fer step in [side, 8 - side, side * 2, 16 - side * 2, side * 3, 24 - side * 3, 4] {
        ken dir = (target + step) % 8
        gin dir != turnaround an actor_try_dir(g, a, dir, speed) {
            gie aye
        }
    }
    gin turnaround >= 0 an actor_try_dir(g, a, turnaround, speed) {
        gie aye
    }
    a["movedir"] = -1
    a["movecount"] = 0
    gie nae
}

# Home straight on the target when the way is clear; round an obstruction,
# hold a chase direction for its count before trying straight again.
dae actor_chase(g, a, tx, ty, speed) {
    gin nae contains(a, "movedir") {
        a["movedir"] = -1
        a["movecount"] = 0
    }
    a["movecount"] = a["movecount"] - 1
    gin a["movecount"] >= 0 an a["movedir"] >= 0 an actor_try_dir(g, a, a["movedir"], speed) {
        gie aye
    }
    ken velocity = actor_towards(a, tx, ty, speed)
    gin actor_try(g, a, velocity[0], velocity[1]) {
        actor_face(g, a, velocity[0], velocity[1])
        a["movedir"] = (bogle_atan2(g["sin"], velocity[0], velocity[1]) + 256) / 512 % 8
        a["movecount"] = 0
        gie aye
    }
    gie actor_new_chase_dir(g, a, tx, ty, speed)
}

# A charge needs a lane for the whole body: the centre line and both flanks,
# sixteen units either side, traced at knee height (just above a climbable
# step) up to contact range of the player.
dae keeper_lane(g, a) {
    ken distance = actor_distance(a["x"], a["y"], g["x"], g["y"])
    gin distance <= 48 {
        gie aye
    }
    ken ux = (g["x"] - a["x"]) / distance
    ken uy = (g["y"] - a["y"]) / distance
    ken z = a["z"] + 25 * 65536
    ken tz = g["z"] + 25 * 65536
    fer side in [0, -16, 16] {
        ken sx = a["x"] - uy * side
        ken sy = a["y"] + ux * side
        ken start = bogle_trace(g, a["x"], a["y"], z, a["sector"], sx, sy, z)
        gin start[1] != -1 {
            gie nae
        }
        ken hit = bogle_trace(g, sx, sy, z, start[0], g["x"] - ux * 32 - uy * side, g["y"] - uy * 32 + ux * side, tz)
        gin hit[1] != -1 {
            gie nae
        }
    }
    gie aye
}

dae ghost_move(g, a, dx, dy) {
    ken x = a["x"] + dx
    ken y = a["y"] + dy
    # Ghosts cross solid walls too. Search convex sectors to locate the centre;
    # outside the map, keep the last valid position until the player turns back.
    fer s in 0..len(g["map"]["floor_h"]) {
        gin map_point(g["map"], s, x / 65536, y / 65536) {
            a["x"] = x
            a["y"] = y
            a["sector"] = s
            actor_face(g, a, dx, dy)
            a["z"] = g["map"]["floor_h"][s] * 65536
            gie naething
        }
    }
}

# Old Wullie (40) walks his round of path points. He is nearly blind: he
# sees the player only within 96 units, inside a 60-degree cone ahead of him
# and with a clear line. After 35 tics of unbroken sight he drains 1 health
# every 7 tics until the sight breaks. He whistles as he goes.
dae wullie_sees(g, a) {
    ken dx = g["x"] - a["x"]
    ken dy = g["y"] - a["y"]
    gin actor_distance(a["x"], a["y"], g["x"], g["y"]) > 96 {
        gie nae
    }
    ken off = bogle_angle(bogle_atan2(g["sin"], dx, dy) - a["facing"])
    gin off > 341 an off < 4096 - 341 {
        gie nae
    }
    gie bogle_sight(g, a["x"], a["y"], a["z"] + 48 * 65536, a["sector"], g["x"], g["y"], g["z"] + 32 * 65536, g["sector"])
}

dae wullie_tick(g, a) {
    ken paths = g["paths"]
    gin len(paths) > 0 {
        ken point = paths[a["path"] % len(paths)]
        gin actor_distance(a["x"], a["y"], point["x"], point["y"]) < 8 {
            a["path"] = (a["path"] + 1) % len(paths)
            point = paths[a["path"]]
        }
        actor_chase(g, a, point["x"], point["y"], 131072)
    }
    gin g["tics"] % 35 == 0 an actor_distance(a["x"], a["y"], g["x"], g["y"]) < 384 {
        bogle_emit_sound(g, "whistle")
    }
    gin wullie_sees(g, a) {
        a["seen"] = a["seen"] + 1
        gin a["seen"] > 35 an (a["seen"] - 36) % 7 == 0 {
            hurt_player(g, 1)
            g["message"] = "Oi! Wha's that?"
        }
    } ither {
        a["seen"] = 0
    }
}

# A grave (41) raises a tartan ghost every 280 tics the player spends within
# 512 of it, while fewer than 3 of its own ghosts walk. Flags 1: a quiet grave.
dae grave_tick(g, a) {
    gin bit_an(a["flags"], 1) != 0 or actor_distance(a["x"], a["y"], g["x"], g["y"]) >= 512 {
        gie naething
    }
    a["timer"] = a["timer"] + 1
    gin a["timer"] < 280 {
        gie naething
    }
    a["timer"] = 0
    ken risen = 0
    fer ghost in g["actors"] {
        gin ghost["active"] an ghost["kind"] == 4 an contains(ghost, "grave") an ghost["grave"] == a["thing"] {
            risen = risen + 1
        }
    }
    gin risen < 3 {
        bogle_emit_sound(g, "ghost")
        shove(g["actors"], {"x": a["x"], "y": a["y"] + 16 * 65536, "z": a["z"], "sector": a["sector"], "angle": 0, "facing": 0, "kind": 4, "flags": 0, "thing": -1, "grave": a["thing"], "health": 60, "state": "chase", "timer": 35, "seen_player": nae, "charge_tics": 0, "vx": 0, "vy": 0, "dx": 0, "dy": 0, "active": aye, "svx": 0, "svy": 0, "kick_tic": -1000})
    }
}

# A thistle (44) hides as a tuft until the player comes within 72, then
# rustles and pops up over 6 tics. Up, it prods 6 within 36 every 24 tics;
# after 105 tics with the player out of reach it sinks back over 6 tics.
# Only an up thistle can be hit, and a killed one stays down.
dae thistle_tick(g, a, distance) {
    ken state = a["state"]
    gin state == "tuft" {
        gin distance < 72 {
            a["state"] = "pop"
            a["timer"] = 0
            bogle_emit_sound(g, "rustle")
        }
        gie naething
    }
    a["timer"] = a["timer"] + 1
    gin state == "pop" or state == "sink" {
        gin a["timer"] >= 6 {
            a["state"] = "up"
            a["timer"] = 24
            a["far"] = 0
            gin state == "sink" {
                a["state"] = "tuft"
            }
        }
        gie naething
    }
    gin state == "prod" an a["timer"] >= 6 {
        a["state"] = "up"
    }
    gin distance < 72 {
        a["far"] = 0
    } ither {
        a["far"] = a["far"] + 1
        gin a["far"] >= 105 {
            a["state"] = "sink"
            a["timer"] = 0
            gie naething
        }
    }
    gin distance < 36 an a["timer"] >= 24 an bogle_sight(g, a["x"], a["y"], a["z"] + 24 * 65536, a["sector"], g["x"], g["y"], g["z"] + 24 * 65536, g["sector"]) {
        hurt_player(g, 6)
        a["state"] = "prod"
        a["timer"] = 0
    }
}

# A tree (45) falls toward the player when they come within 96, or when they
# stand still (no movement keys) for 105 tics within 192, either way in
# sight. It falls over 18 tics along its 120-unit length (its height);
# landing hurts 25 if the player is within 24 of that line. Then it lies as
# dressing. Once each.
ken TREE_LENGTH = 120

dae tree_tick(g, a, distance) {
    gin a["state"] == "standing" {
        gin distance < 192 an bit_an(g["held_keys"], 15) == 0 {
            a["still"] = a["still"] + 1
        } ither {
            a["still"] = 0
        }
        gin (distance < 96 or a["still"] >= 105) an bogle_sight(g, a["x"], a["y"], a["z"] + 48 * 65536, a["sector"], g["x"], g["y"], g["z"] + 32 * 65536, g["sector"]) {
            ken fall = actor_towards(a, g["x"], g["y"], 65536)
            gin fall[0] == 0 an fall[1] == 0 {
                fall = [65536, 0]
            }
            a["dx"] = fall[0]
            a["dy"] = fall[1]
            actor_face(g, a, fall[0], fall[1])
            a["state"] = "falling"
            a["timer"] = 0
            bogle_emit_sound(g, "timber")
        }
    } ither gin a["state"] == "falling" {
        a["timer"] = a["timer"] + 1
        gin a["timer"] >= 18 {
            a["state"] = "fallen"
            bogle_emit_sound(g, "thud")
            gin tree_line_distance(a, g["x"], g["y"]) <= 24 {
                hurt_player(g, 25)
                g["message"] = "TIMBER! Flattened by a Scots pine."
            }
        }
    }
}

# Map units from x,y to the tree's fall line (unit direction dx,dy in 16.16).
dae tree_line_distance(a, x, y) {
    ken px = (x - a["x"]) / 65536
    ken py = (y - a["y"]) / 65536
    ken along = max(0, min(TREE_LENGTH, (px * a["dx"] + py * a["dy"]) / 65536))
    ken ex = px - a["dx"] * along / 65536
    ken ey = py - a["dy"] * along / 65536
    gie isqrt(ex * ex + ey * ey)
}

# The rat (42) lurks until it sees the player within 384, then runs him down
# fast (five units a tic) and bites 4 within 24 every 18 tics, the first bite
# as soon as it arrives.
dae rat_tick(g, a, distance) {
    ken near = distance < 24 an bogle_sight(g, a["x"], a["y"], a["z"] + 16 * 65536, a["sector"], g["x"], g["y"], g["z"] + 16 * 65536, g["sector"])
    gin a["state"] == "idle" {
        gin distance < 384 an bogle_sight(g, a["x"], a["y"], a["z"] + 16 * 65536, a["sector"], g["x"], g["y"], g["z"] + 32 * 65536, g["sector"]) {
            a["state"] = "chase"
            a["timer"] = 18
        }
        gie naething
    }
    gin a["timer"] < 18 {
        a["timer"] = a["timer"] + 1
    }
    gin near {
        gin a["timer"] >= 18 {
            a["timer"] = 0
            hurt_player(g, 4)
        }
    } ither {
        actor_chase(g, a, g["x"], g["y"], 327680)
    }
}

dae story_actors_tick(g) {
    ken count = len(g["actors"])
    fer i in 0..count {
        ken a = g["actors"][i]
        gin a["active"] an a["kind"] == 40 {
            wullie_tick(g, a)
        }
        gin a["active"] an a["kind"] == 41 {
            grave_tick(g, a)
        }
    }
}

dae ai_tick(g) {
    gin g["health"] <= 0 {
        gie naething
    }
    story_actors_tick(g)
    fer a in g["actors"] {
        gin a["active"] an bogle_is_monster(a["kind"]) {
            gin a["state"] == "stunned" {
                actor_face(g, a, g["x"] - a["x"], g["y"] - a["y"])
                a["timer"] = a["timer"] - 1
                gin a["timer"] <= 0 {
                    a["state"] = "chase"
                    gin a["kind"] == 2 or a["kind"] == 43 {
                        a["state"] = "patrol"
                    }
                    gin a["kind"] == 44 {
                        a["state"] = "up"
                    }
                }
            } ither {
                ken distance = actor_distance(a["x"], a["y"], g["x"], g["y"])
                ken kind = a["kind"]
                # The mad deer (43) charges like the gamekeeper, without the
                # fists, and hits harder.
                gin kind == 2 or kind == 43 {
                    gin a["state"] == "windup" or a["state"] == "fists" {
                        actor_face(g, a, g["x"] - a["x"], g["y"] - a["y"])
                        a["timer"] = a["timer"] - 1
                        gin a["timer"] <= 0 {
                            a["state"] = "charge"
                            a["charge_tics"] = 0
                            # The player slipped behind cover: hunt instead.
                            gin nae keeper_lane(g, a) {
                                a["state"] = "chase"
                            }
                        }
                    } ither gin a["state"] == "charge" {
                        a["charge_tics"] = a["charge_tics"] + 1
                        ken ahead = (g["x"] - a["x"]) / 65536 * a["dx"] + (g["y"] - a["y"]) / 65536 * a["dy"]
                        gin distance < 32 an bogle_sight(g, a["x"], a["y"], a["z"] + 24 * 65536, a["sector"], g["x"], g["y"], g["z"] + 24 * 65536, g["sector"]) {
                            ken hit = 15
                            gin kind == 43 {
                                hit = 20
                            }
                            hurt_player(g, hit)
                            a["state"] = "stunned"
                            a["timer"] = 35
                        } ither gin ahead < 0 or a["charge_tics"] > 70 {
                            # Overshot or ran out of puff: skid, then turn and wind up again.
                            a["state"] = "stunned"
                            a["timer"] = 12
                        } ither {
                            # Bend the charge towards the player a quarter at a time, so he
                            # tracks a sidestep but a late dodge still makes him miss.
                            gin bogle_sight(g, a["x"], a["y"], a["z"] + 32 * 65536, a["sector"], g["x"], g["y"], g["z"] + 32 * 65536, g["sector"]) {
                                ken aim = actor_towards(a, g["x"], g["y"], 163840)
                                a["dx"] = (a["dx"] * 3 + aim[0]) / 4
                                a["dy"] = (a["dy"] * 3 + aim[1]) / 4
                            }
                            actor_face(g, a, a["dx"], a["dy"])
                            gin nae actor_move(g, a, a["dx"], a["dy"]) {
                                a["state"] = "stunned"
                                a["timer"] = 35
                            }
                        }
                    } ither {
                        ken sees = bogle_sight(g, a["x"], a["y"], a["z"] + 32 * 65536, a["sector"], g["x"], g["y"], g["z"] + 32 * 65536, g["sector"])
                        gin sees {
                            a["last_x"] = g["x"]
                            a["last_y"] = g["y"]
                            a["hunt_tics"] = 175
                        } ither gin nae contains(a, "hunt_tics") {
                            a["hunt_tics"] = 0
                        }
                        gin sees an (nae a["seen_player"] or keeper_lane(g, a)) {
                            ken velocity = actor_towards(a, g["x"], g["y"], 163840)
                            a["dx"] = velocity[0]
                            a["dy"] = velocity[1]
                            ken cue = "gamekeeper"
                            gin kind == 43 {
                                cue = "deer_snort"
                            }
                            bogle_emit_sound(g, cue)
                            actor_face(g, a, g["x"] - a["x"], g["y"] - a["y"])
                            a["state"] = "windup"
                            a["timer"] = 18
                            gin nae a["seen_player"] {
                                a["seen_player"] = aye
                                gin kind == 2 {
                                    bogle_emit_sound(g, "keeper_roar")
                                    a["state"] = "fists"
                                    a["timer"] = 35
                                }
                            }
                        } ither gin a["hunt_tics"] > 0 {
                            # No lane, or no sight: walk round the cover towards the
                            # player, or to where he was last seen, then patrol again.
                            a["hunt_tics"] = a["hunt_tics"] - 1
                            a["state"] = "chase"
                            gin nae sees an actor_distance(a["x"], a["y"], a["last_x"], a["last_y"]) < 24 {
                                a["hunt_tics"] = 0
                            } ither {
                                actor_chase(g, a, a["last_x"], a["last_y"], 131072)
                            }
                            gin a["hunt_tics"] <= 0 {
                                a["state"] = "patrol"
                                a["timer"] = 0
                            }
                        } ither {
                            # Seeded patrol turns only when a wall interrupts a leg.
                            gin a["timer"] <= 0 {
                                a["angle"] = game_random(g) % 4096
                                a["timer"] = 35
                            }
                            a["timer"] = a["timer"] - 1
                            a["facing"] = bogle_angle(a["angle"])
                            gin nae actor_move(g, a, bogle_cos(g["sin"], a["angle"]), bogle_sin(g["sin"], a["angle"])) {
                                a["timer"] = 0
                            }
                        }
                    }
                }
                gin kind == 3 {
                    gin a["state"] == "dormant" an distance < 256 {
                        a["state"] = "chase"
                        bogle_emit_sound(g, "haggis_fuse")
                    }
                    gin a["state"] == "chase" {
                        gin distance < 512 an g["tics"] % 14 == 0 {
                            bogle_emit_sound(g, "haggis_fuse")
                        }
                        gin distance < 28 an bogle_sight(g, a["x"], a["y"], a["z"] + 24 * 65536, a["sector"], g["x"], g["y"], g["z"] + 24 * 65536, g["sector"]) {
                            damage_actor(g, a, 1)
                        } ither {
                            # Homes straight in, but works round a pillar or corner.
                            actor_chase(g, a, g["x"], g["y"], 196608)
                        }
                    }
                }
                gin kind == 4 {
                    ken velocity = actor_towards(a, g["x"], g["y"], 49152)
                    ghost_move(g, a, velocity[0], velocity[1])
                    gin a["timer"] > 0 {
                        a["timer"] = a["timer"] - 1
                    }
                    gin a["timer"] <= 0 an distance >= 64 an distance < 768 an bogle_sight(g, a["x"], a["y"], a["z"] + 32 * 65536, a["sector"], g["x"], g["y"], g["z"] + 32 * 65536, g["sector"]) {
                        velocity = actor_towards(a, g["x"], g["y"], 6 * 65536)
                        bogle_emit_sound(g, "ghost")
                        spawn_projectile(g, "wail", a["x"], a["y"], a["z"] + 32 * 65536, a["sector"], velocity[0], velocity[1], 0, a)
                        a["timer"] = 70
                    }
                }
                gin kind == 44 {
                    thistle_tick(g, a, distance)
                }
                gin kind == 45 {
                    tree_tick(g, a, distance)
                }
                gin kind == 42 {
                    rat_tick(g, a, distance)
                }
                gin kind == 5 {
                    gin distance < 256 an (g["tics"] % 7 == 1) {
                        bogle_emit_sound(g, "midge")
                    }
                    ken velocity = actor_towards(a, g["x"], g["y"], 32768)
                    actor_move(g, a, velocity[0], velocity[1])
                    a["timer"] = a["timer"] + 1
                    gin a["timer"] >= 5 {
                        a["timer"] = 0
                        gin distance < 40 an abs(g["z"] - a["z"]) < 56 * 65536 an bogle_sight(g, a["x"], a["y"], a["z"] + 24 * 65536, a["sector"], g["x"], g["y"], g["z"] + 24 * 65536, g["sector"]) {
                            hurt_player(g, 1)
                        }
                    }
                }
            }
        }
    }
}
