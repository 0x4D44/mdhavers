dae load_trig() {
    ken result = []
    ken lines = split(read_file("games/bogle/data/trig.txt"), "\n")
    fer line in lines {
        gin wheesht(line) != "" {
            shove(result, tae_int(wheesht(line)))
        }
    }
    gin len(result) != 4096 {
        hurl "Bogle sine table needs 4096 entries"
    }
    gie result
}

dae bogle_angle(angle) {
    ken a = angle % 4096
    gin a < 0 {
        a = a + 4096
    }
    gie a
}

dae bogle_sin(table, angle) {
    gie table[bogle_angle(angle)]
}

dae bogle_cos(table, angle) {
    gie table[bogle_angle(bogle_angle(angle) + 1024)]
}

# Integer atan2 in the 4096-unit angle space: the angle a with (cos a, sin a)
# pointing along (dx, dy). A 10-step search of the first octant of the sine
# table, then octant folding; (0, 0) gives 0. Inputs must stay below 2^46.
dae bogle_atan2(table, dx, dy) {
    gin dx == 0 an dy == 0 {
        gie 0
    }
    ken ax = abs(dx)
    ken ay = abs(dy)
    ken small = min(ax, ay)
    ken big = max(ax, ay)
    ken lo = 0
    ken hi = 512
    whiles lo < hi {
        ken mid = (lo + hi + 1) / 2
        gin table[mid] * big <= table[mid + 1024] * small {
            lo = mid
        } ither {
            hi = mid - 1
        }
    }
    ken a = lo
    gin ay > ax {
        a = 1024 - a
    }
    gin dx < 0 {
        a = 2048 - a
    }
    gin dy < 0 {
        a = 4096 - a
    }
    gie bogle_angle(a)
}
