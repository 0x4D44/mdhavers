# The campaign replay: New Game, the opening card, each briefing and the
# five level routes chained (replays/<level>.txt, each cut at the tic that
# wins it), then the ending screen. Every play frame carries exactly one
# gameplay tic at the shell's tic length (the frame times alternate 28 and
# 29 ms so 35 tics land in each second). It drives the real front end, so it
# checks each level starts from the carry its route was made from and ends
# on the ending screen. Run from the repository root:
#   BOGLE_ROUTE_OUT=games/bogle/replays/campaign.txt mdhavers run games/bogle/tools/route_campaign.braw
fetch "games/bogle/shell/frontend"

ken cr_out = bogle_option("BOGLE_ROUTE_OUT", "games/bogle/replays/campaign.txt")
ken cr_ui = bogle_front_new("games/bogle/data/kirkyard.map")
ken cr_lines = []
ken cr_play = {"frames": 0}

dae cr_frame(ui, dt, menu, keys, dx) {
    bogle_front_step(ui, dt, {"menu": menu, "keys": keys, "dx": dx})
    shove(cr_lines, tae_string(dt) + " " + tae_string(menu) + " " + tae_string(keys) + " " + tae_string(dx))
}

# Press and release a menu key: one frame held, one frame let go.
dae cr_press(ui, menu, screen) {
    cr_frame(ui, 0, menu, 0, 0)
    cr_frame(ui, 0, 0, 0, 0)
    mak_siccar ui["screen"] == screen
}

# The frame time that makes the n-th play frame due exactly one tic: the
# front end's accumulator restarts at 0 on each screen change.
dae cr_tic_frame(ui, keys, dx) {
    ken n = cr_play["frames"] + 1
    ken dt = (1000 * n + 34) / 35 - (1000 * (n - 1) + 34) / 35
    cr_play["frames"] = n
    cr_frame(ui, dt, 0, keys, dx)
}

cr_press(cr_ui, 16, "title")
cr_press(cr_ui, 4, "opening")
cr_press(cr_ui, 16, "briefing")
fer level in ["kirkyard", "forest", "distillery", "tower", "lab"] {
    ken g = cr_ui["game"]
    mak_siccar cr_ui["map_path"] == "games/bogle/data/" + level + ".map"
    ken carry_path = "games/bogle/replays/" + level + ".carry"
    gin file_exists(carry_path) {
        ken fresh = new_game(load_map(cr_ui["map_path"]))
        ken want = bogle_parse_carry(read_file(carry_path), fresh)
        gin tae_string(bogle_front_carry(g)) != tae_string(want) {
            hurl level + " starts frae " + tae_string(bogle_front_carry(g)) + ", its route frae " + tae_string(want)
        }
    }
    cr_press(cr_ui, 16, "play")
    cr_play["frames"] = 0
    ken tics = 0
    fer input in replay_inputs("games/bogle/replays/" + level + ".txt") {
        gin cr_ui["screen"] != "play" {
            brak
        }
        cr_tic_frame(cr_ui, input["keys"], input["dx"])
        tics = tics + 1
    }
    blether level + " won in " + tae_string(tics) + " frames, clock " + tae_string(cr_ui["clock"]) + ", screen " + cr_ui["screen"]
    mak_siccar g["won"] an g["health"] > 0
}
mak_siccar cr_ui["screen"] == "ending"
cr_frame(cr_ui, 0, 0, 0, 0)
cr_frame(cr_ui, 0, 0, 0, 0)
blether "ending tier " + tae_string(cr_ui["ending"]) + " at clock " + tae_string(cr_ui["clock"]) + " in " + tae_string(len(cr_lines)) + " frames"
mak_siccar cr_ui["ending"] == 0
ken cr_text = "# dt_ms menu keys dx -- the campaign, generated by tools/route_campaign.braw\n"
fer line in cr_lines {
    cr_text = cr_text + line + "\n"
}
scrieve(cr_out, cr_text)
blether "wrote " + cr_out
