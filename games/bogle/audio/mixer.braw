# All synthesis is integer and deterministic. PCM is mono signed 16-bit LE,
# 22050 frames/second. Slot zero belongs to the sustained bagpipe drone;
# eleven finite voices rotate without allocating anything inside a sample loop.
# Kind 6 voices play a baked one-shot BMU1 sample from mixer["samples"]; the
# shell registers them with bogle_audio_sample. An unregistered name is silent.
# "focus_gain" is a master gain over the whole mix, 0..8192 (full), moving
# one step per output sample toward "focus_target" (8192 samples, ~0.37 s).
dae bogle_audio_new() {
    ken voices = []
    fer i in 0..12 {
        shove(voices, [0, 0, 0, 0, 0, 0, 0, 1, 0, 1, 0])
    }
    gie {"voices": voices, "next": 1, "seed": 12345, "samples": {}, "drone_gain": 0, "drone_target": 0, "focus_gain": 8192, "focus_target": 8192, "music": {"track": naething, "old": naething, "pos": 0, "old_pos": 0, "cross": 512, "gain": 0, "target": 0}}
}

dae bogle_audio_event(mixer, event) {
    gin event == "pipe_stop" or event == "pipe_blast" or event == "pipe_deflate" {
        mixer["voices"][0][0] = 0
        mixer["drone_gain"] = 0
        mixer["drone_target"] = 0
    }
    gin event == "pipe_stop" {
        gie naething
    }
    # kind, duration, start/end Hz, amplitude, noise hold period, noise mix /256.
    ken profile = []
    gin event == "keeper_roar" {
        gin nae contains(mixer["samples"], event) {
            gie naething
        }
        # Sample voice: position in voice[1], length in voice[2], gain /256 in
        # voice[6], the loaded track in voice[7].
        ken clip = mixer["samples"][event]
        ken clip_slot = mixer["next"]
        mixer["next"] = 1 + clip_slot % 11
        mixer["voices"][clip_slot] = [6, 0, clip["count"], 0, 0, 0, 160, clip, 0, 0, 0]
        gie naething
    }
    gin event == "pipe_fill" {
        profile = [1, 0, 110, 110, 1200, 1, 0]
        mixer["drone_target"] = 256
    }
    gin event == "pipe_blast" {
        profile = [2, 8500, 660, 165, 10000, 3, 48]
    }
    gin event == "pipe_deflate" {
        profile = [2, 5500, 330, 35, 6500, 8, 32]
    }
    gin event == "sgian_dubh" {
        profile = [3, 1800, 1700, 300, 6500, 1, 180]
    }
    gin event == "mars_throw" {
        profile = [3, 3500, 230, 800, 6500, 6, 24]
    }
    gin event == "mars_splat" {
        profile = [4, 4200, 120, 30, 10000, 18, 256]
    }
    gin event == "blunderbuss" {
        profile = [4, 9500, 90, 25, 16000, 2, 230]
    }
    gin event == "door" {
        profile = [2, 11000, 82, 45, 6000, 48, 100]
    }
    gin event == "pickup" {
        profile = [3, 4600, 500, 1350, 7000, 1, 0]
    }
    gin event == "gamekeeper" {
        profile = [2, 7500, 145, 70, 8000, 70, 40]
    }
    gin event == "haggis_fuse" {
        profile = [4, 12000, 900, 1800, 5000, 1, 256]
    }
    gin event == "explosion" {
        profile = [4, 14000, 65, 20, 20000, 7, 220]
    }
    gin event == "ghost" {
        profile = [5, 15000, 480, 190, 6500, 1, 0]
    }
    gin event == "midge" {
        profile = [4, 1800, 180, 110, 900, 7, 240]
    }
    gin event == "stone_rumble" {
        # Shorter than the seven-tic retrigger (4410 samples), so never overlapping.
        profile = [4, 3600, 70, 50, 5200, 14, 210]
    }
    gin event == "stone_clack" {
        profile = [3, 1400, 1250, 520, 9000, 2, 140]
    }
    gin event == "oof" {
        profile = [3, 4500, 180, 55, 8000, 45, 50]
    }
    gin event == "menu" {
        profile = [3, 1900, 800, 1050, 4000, 1, 0]
    }
    gin len(profile) == 0 {
        gie naething
    }
    ken slot = 0
    gin event != "pipe_fill" {
        slot = mixer["next"]
        mixer["next"] = 1 + slot % 11
    } ither {
        # Repeated held-fire events cannot restart the drone's phase/envelope.
        gin mixer["voices"][0][0] != 0 {
            gie naething
        }
    }
    mixer["seed"] = mixer["seed"] * 48271 % 2147483647
    mixer["voices"][slot] = [
        profile[0],
        0,
        profile[1],
        0,
        profile[2] * 65536 / 22050,
        profile[3] * 65536 / 22050,
        profile[4],
        mixer["seed"],
        0,
        profile[5],
        profile[6],
    ]
}

dae bogle_audio_events(mixer, events) {
    fer event in events {
        bogle_audio_event(mixer, event)
    }
}

dae bogle_audio_mix(mixer, sample_count) {
    gin sample_count < 0 or sample_count > 22050 {
        hurl "Bogle audio wants frae zero tae 22050 samples"
    }
    ken pcm = bytes(sample_count * 2)
    ken active = nae
    fer voice in mixer["voices"] {
        gin voice[0] != 0 {
            active = aye
        }
    }
    gin (nae active an mixer["music"]["track"] == naething an mixer["music"]["old"] == naething) or sample_count == 0 {
        # Silence still spends the fade's time, so a later sound starts at the
        # gain the ramp would have reached.
        ken drift = mixer["focus_target"] - mixer["focus_gain"]
        mixer["focus_gain"] = mixer["focus_gain"] + max(-sample_count, min(sample_count, drift))
        gie pcm
    }
    ken sums = []
    fer i in 0..sample_count {
        shove(sums, bogle_music_sample(mixer["music"]))
    }
    fer voice in mixer["voices"] {
        ken kind = voice[0]
        gin kind == 6 {
            ken clip = voice[7]
            ken pos = voice[1]
            ken at = 0
            whiles at < sample_count an pos < voice[2] {
                sums[at] = sums[at] + clip["table"][bytes_get(clip["data"], 16 + pos)] * voice[6] / 256
                at = at + 1
                pos = pos + 1
            }
            voice[1] = pos
            gin pos >= voice[2] {
                voice[0] = 0
            }
        } ither gin kind != 0 {
            ken age = voice[1]
            ken duration = voice[2]
            ken phase = voice[3]
            ken start = voice[4]
            ken finish = voice[5]
            ken amplitude = voice[6]
            ken seed = voice[7]
            ken noise = voice[8]
            ken hold = voice[9]
            ken blend = voice[10]
            ken at = 0
            whiles at < sample_count an (duration == 0 or age < duration) {
                ken step = start
                ken envelope = amplitude
                gin duration != 0 {
                    step = start + (finish - start) * age / duration
                    envelope = amplitude * (duration - age) / duration
                }
                gin kind == 1 {
                    ken gain = mixer["drone_gain"]
                    gain = gain + max(-1, min(1, mixer["drone_target"] - gain))
                    mixer["drone_gain"] = gain
                    envelope = envelope * gain / 256
                    gin gain == 0 an mixer["drone_target"] == 0 {
                        voice[0] = 0
                    }
                }
                gin age < 64 {
                    envelope = envelope * age / 64
                }
                phase = (phase + step) % 65536
                # Triangle [-256,256], optionally a hollow square/reed tone.
                ken wave = phase / 64 - 256
                gin phase >= 32768 {
                    wave = 768 - phase / 64
                }
                gin kind == 2 {
                    wave = 256
                    gin phase >= 32768 {
                        wave = -256
                    }
                }
                gin kind == 1 {
                    ken reed = 128
                    gin (phase * 3) % 65536 >= 32768 {
                        reed = -128
                    }
                    wave = (wave + reed) * 2 / 3
                }
                gin kind == 5 {
                    # A slow wavering spectral moan.
                    wave = wave * (64 + abs((age / 12) % 256 - 128)) / 192
                }
                gin blend != 0 {
                    gin age % hold == 0 {
                        seed = seed * 48271 % 2147483647
                        noise = seed % 513 - 256
                    }
                    wave = (wave * (256 - blend) + noise * blend) / 256
                }
                sums[at] = sums[at] + wave * envelope / 256
                at = at + 1
                age = age + 1
            }
            voice[1] = age
            voice[3] = phase
            voice[7] = seed
            voice[8] = noise
            gin duration != 0 an age >= duration {
                voice[0] = 0
            }
        }
    }
    ken focus = mixer["focus_gain"]
    ken focus_target = mixer["focus_target"]
    fer i in 0..sample_count {
        ken value = max(-32768, min(32767, sums[i]))
        gin focus != focus_target {
            focus = focus + max(-1, min(1, focus_target - focus))
        }
        gin focus != 8192 {
            value = value * focus / 8192
        }
        gin value < 0 {
            value = value + 65536
        }
        bytes_set(pcm, i * 2, value % 256)
        bytes_set(pcm, i * 2 + 1, value / 256)
    }
    mixer["focus_gain"] = focus
    gie pcm
}

# Window focus fades everything the mixer outputs, without pausing anything:
# music positions and effect voices keep advancing under the master gain.
dae bogle_audio_focus(mixer, focused) {
    mixer["focus_target"] = 0
    gin focused {
        mixer["focus_target"] = 8192
    }
}

# Shell reconciles the sustained voice with the live held-fire cause, rather
# than a charged bag left behind by a pause or a simulation transition.
dae bogle_audio_held(mixer, held) {
    gin held {
        bogle_audio_event(mixer, "pipe_fill")
        mixer["drone_target"] = 256
    } ither {
        mixer["drone_target"] = 0
    }
}

# Standard G.711 mu-law: invert the byte, expand exponent/mantissa with
# bias 0x84. The encoder clips its linear input at 32635.
dae bogle_mulaw(value) {
    ken bits = 255 - value
    ken magnitude = (bit_an(bits, 15) * 8 + 132) * bogle_music_pow2(bit_an(bits / 16, 7)) - 132
    gin bit_an(bits, 128) != 0 {
        gie -magnitude
    }
    gie magnitude
}

dae bogle_music_pow2(power) {
    ken value = 1
    fer i in 0..power {
        value = value * 2
    }
    gie value
}

# Register a loaded one-shot sample for an event. A missing or invalid file
# loads as naething and is never registered, so its event stays silent.
dae bogle_audio_sample(mixer, name, clip) {
    gin clip != naething {
        mixer["samples"][name] = clip
    }
}

# Music files loop from L < N. A one-shot effect (`oneshot`) may also use
# L == N, meaning no loop; its voice simply ends at N.
dae bogle_music_load(path, oneshot = nae) {
    ken track = naething
    hae_a_bash {
        ken data = read_bytes(path)
        gin bytes_len(data) >= 16 {
            ken header = bytes_from_string("BMU1")
            ken valid = aye
            fer i in 0..4 {
                gin bytes_get(data, i) != bytes_get(header, i) {
                    valid = nae
                }
            }
            ken rate = bytes_read_u32be(data, 4)
            ken count = bytes_read_u32be(data, 8)
            ken loop = bytes_read_u32be(data, 12)
            gin valid an rate == 22050 an count > 0 an (loop < count or (oneshot an loop == count)) an bytes_len(data) == count + 16 {
                ken table = []
                fer i in 0..256 {
                    shove(table, bogle_mulaw(i))
                }
                track = {"data": data, "count": count, "loop": loop, "table": table, "path": path}
            }
        }
    } gin_it_gangs_wrang err {
        track = naething
    }
    gie track
}

# M fades only the music. Focus is passed through to the master focus fade.
dae bogle_music_select(mixer, track, enabled, focused = aye) {
    bogle_audio_focus(mixer, focused)
    ken music = mixer["music"]
    ken changed = (music["track"] == naething) != (track == naething)
    gin music["track"] != naething an track != naething {
        changed = music["track"]["path"] != track["path"]
    }
    gin changed {
        music["old"] = music["track"]
        music["old_pos"] = music["pos"]
        music["track"] = track
        music["pos"] = 0
        music["cross"] = 0
    }
    # With no source or fading tail there is no audible envelope to retain.
    # Reset it so muting during a missing track cannot leak a later track.
    gin music["track"] == naething an music["old"] == naething {
        music["gain"] = 0
    }
    music["target"] = 0
    gin enabled {
        music["target"] = 512
    }
}

dae bogle_music_sample(music) {
    gin music["track"] == naething an music["old"] == naething {
        gie 0
    }
    ken result = 0
    fer side in 0..2 {
        ken track = music["track"]
        ken key = "pos"
        ken weight = music["cross"]
        gin side == 1 {
            track = music["old"]
            key = "old_pos"
            weight = 512 - weight
        }
        gin track != naething {
            ken pos = music[key]
            result = result + track["table"][bytes_get(track["data"], 16 + pos)] * weight / 512
            pos = pos + 1
            gin pos >= track["count"] {
                pos = track["loop"]
            }
            music[key] = pos
        }
    }
    music["cross"] = min(512, music["cross"] + 1)
    gin music["cross"] == 512 {
        music["old"] = naething
    }
    music["gain"] = music["gain"] + max(-1, min(1, music["target"] - music["gain"]))
    gie result * music["gain"] * 48 / 131072
}
