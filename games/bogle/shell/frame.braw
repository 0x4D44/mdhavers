fetch "frontend"
fetch "games/bogle/audio/mixer"

ken bogle_ui = naething
ken bogle_fb = naething
ken bogle_palette = naething
ken bogle_width = 320
ken bogle_height = 200
ken bogle_record = naething
ken bogle_sound = naething
ken bogle_music_title = naething
ken bogle_music_gatehouse = naething

dae bogle_init(w, h) {
    bogle_width = w
    bogle_height = h
    bogle_fb = bytes(w * h)
    bogle_palette = make_palette()
    bogle_ui = bogle_front_new(bogle_option("BOGLE_MAP", "games/bogle/data/e1m1.map"))
    bogle_record = env_get("BOGLE_RECORD")
    ken options = args()
    fer i in 0..len(options) {
        gin options[i] == "--record" {
            gin i + 1 >= len(options) {
                hurl "--record wants a replay path"
            }
            bogle_record = options[i + 1]
        }
    }
    screen_open(w, h, "Bogle Castle - The Gatehouse")
    screen_grab_mouse(nae)
    # The native bridge also honours these flags, but avoid even opening its
    # null stream in an offscreen shell. Replay hosts never import frame.braw.
    gin env_get("MDH_SCREEN") != "none" an env_get("MDH_SOUND") != "none" {
        bogle_music_title = bogle_music_load("games/bogle/data/music_title.bmu")
        bogle_music_gatehouse = bogle_music_load("games/bogle/data/music_gatehouse.bmu")
        bogle_sound = bogle_sound_start(bogle_open_device)
        gin bogle_sound != naething {
            bogle_sound_frame([])
        }
    }
}

dae bogle_open_device(rate, channels) {
    sound_open(rate, channels)
}

# A missing or busy audio device costs the sound, never the game: report it
# once and play on silent (bogle_sound stays naething).
dae bogle_sound_start(opener) {
    ken opened = aye
    hae_a_bash {
        opener(22050, 1)
    } gin_it_gangs_wrang err {
        blether "Bogle: nae sound the day, playin on quiet (" + tae_string(err) + ")"
        opened = nae
    }
    gin opened {
        gie bogle_audio_new()
    }
    gie naething
}

dae bogle_frame(dt_ms) {
    ken keys = 0
    gin key_down("w") {
        keys = keys + 1
    }
    gin key_down("s") {
        keys = keys + 2
    }
    gin key_down("a") {
        keys = keys + 4
    }
    gin key_down("d") {
        keys = keys + 8
    }
    gin key_down("left") {
        keys = keys + 16
    }
    gin key_down("right") {
        keys = keys + 32
    }
    gin key_down("space") or mouse_down(0) {
        keys = keys + 64
    }
    gin key_down("e") {
        keys = keys + 128
    }
    fer weapon in 1..5 {
        gin key_down(tae_string(weapon)) {
            keys = keys + 128 * bogle_pow2(weapon)
        }
    }
    ken menu = 0
    gin key_down("up") or key_down("w") {
        menu = menu + 1
    }
    gin key_down("down") or key_down("s") {
        menu = menu + 2
    }
    gin key_down("enter") or key_down("space") {
        menu = menu + 4
    }
    gin key_down("escape") {
        menu = menu + 8
    }
    gin key_down("m") {
        menu = bit_or(menu, 32)
    }
    # Keep the Any Key bit stable across title -> briefing. Introducing it
    # only after the transition makes held Enter look like a fresh press.
    ken any_key = mouse_down(0) or mouse_down(1)
    fer name in "abcdefghijklmnopqrstuvwxyz0123456789" {
        gin key_down(name) {
            any_key = aye
        }
    }
    fer name in ["up", "down", "left", "right", "space", "enter", "escape", "shift", "ctrl", "alt", "tab"] {
        gin key_down(name) {
            any_key = aye
        }
    }
    menu = bogle_front_menu(menu, any_key)
    ken before = bogle_ui["screen"]
    ken run = bogle_ui["run"]
    ken keep = bogle_front_step(bogle_ui, dt_ms, {"menu": menu, "keys": keys, "dx": mouse_dx()})
    gin before != bogle_ui["screen"] {
        screen_grab_mouse(bogle_ui["screen"] == "play")
    }
    gin bogle_record != naething {
        gin run != bogle_ui["run"] {
            scrieve(bogle_record, "")
        }
        fer input in bogle_ui["consumed"] {
            scrieve_append(bogle_record, tae_string(input["keys"]) + " " + tae_string(input["dx"]) + "\n")
        }
    }
    gin bogle_sound != naething {
        gin run != bogle_ui["run"] {
            ken music = bogle_sound["music"]
            bogle_sound = bogle_audio_new()
            bogle_sound["music"] = music
        }
        ken held = nae
        gin bogle_ui["screen"] == "play" {
            ken game = bogle_ui["game"]
            held = game["weapon"] == 4 an game["bag_charge"] > 0 an game["health"] > 0 an nae game["won"] an bit_an(keys, 64) != 0 an bit_an(bogle_ui["blocked_keys"], 64) == 0
        }
        bogle_sound_frame(bogle_ui["sounds"], held)
    }
    gin keep {
        bogle_front_render(bogle_ui, bogle_fb, bogle_width, bogle_height)
        screen_shaw(bogle_fb, bogle_palette)
    }
    gie keep
}

# Keep 60ms of PCM ahead; bound each fill even after a slow frame. The mixer
# has no device/clock knowledge, and the engine never sees queue depth.
dae bogle_sound_frame(events, held = nae) {
    bogle_audio_events(bogle_sound, events)
    # Events can include several tics; the current shell state owns sustain.
    gin bogle_ui != naething an bogle_ui["screen"] != "play" {
        held = nae
    }
    bogle_audio_held(bogle_sound, held)
    ken track = bogle_music_title
    gin bogle_ui["screen"] == "play" {
        track = bogle_music_gatehouse
    }
    bogle_music_select(bogle_sound, track, bogle_ui["music_enabled"])
    ken needed = max(0, 1323 - sound_queued())
    gin needed > 0 {
        sound_queue(bogle_audio_mix(bogle_sound, needed))
    }
}

dae bogle_close() {
    gin bogle_sound != naething {
        sound_close()
        bogle_sound = naething
    }
    screen_close()
}
