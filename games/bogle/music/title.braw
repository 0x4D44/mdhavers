# The Laird's Missing Slipper — original Bogle Castle title march.
# D mixolydian, 4/4, quarter = 75. 24 bars = 76.8 seconds.
# A pompous question, a sidelong answer, then a less certain return.
fetch "games/bogle/music/midi"

ken title_tune = [
    [[62,3],[66,1],[69,2],[67,1],[64,1]],
    [[66,2],[62,2],[60,1],[62,1],[0,2]],
    [[67,2],[71,1],[69,1],[66,3],[64,1]],
    [[62,4],[0,2],[64,1],[66,1]],
    [[69,3],[72,1],[71,2],[67,2]],
    [[66,1],[67,1],[69,2],[64,2],[0,2]],
    [[60,2],[64,1],[67,1],[66,2],[62,1],[64,1]],
    [[62,5],[0,3]],
    # Middle strain: fiddle takes the tune; the pipes listen.
    [[67,3],[64,1],[62,2],[60,2]],
    [[64,2],[67,1],[69,1],[71,2],[0,2]],
    [[72,2],[69,1],[67,1],[64,3],[62,1]],
    [[60,4],[0,2],[62,1],[64,1]],
    [[66,2],[69,2],[74,1],[72,1],[69,2]],
    [[67,3],[66,1],[64,2],[0,2]],
    [[60,1],[62,1],[64,2],[66,1],[64,1],[60,2]],
    [[62,4],[0,4]],
    # Return varies both rhythm and cadence, rather than another exact A.
    [[62,2],[66,1],[69,1],[67,3],[64,1]],
    [[66,3],[64,1],[62,2],[0,2]],
    [[67,2],[71,1],[72,1],[69,2],[66,1],[64,1]],
    [[62,3],[60,1],[62,2],[0,2]],
    [[69,2],[72,1],[71,1],[67,2],[64,2]],
    [[66,2],[69,1],[67,1],[64,2],[0,2]],
    [[60,2],[64,2],[66,1],[64,1],[62,2]],
    [[62,3],[57,1],[60,2],[0,2]]
]
ken title_roots = [38,38,43,38,36,38,36,38,43,43,36,36,38,43,36,38,38,38,43,38,36,43,36,38]
ken title_chords = [[62,66,69],[62,66,69],[59,62,67],[62,66,69],[60,64,67],[62,66,69],[60,64,67],[62,66,69]]
ken title_pipes = []
ken title_harp = []
ken title_fiddle = []
ken title_drone = []
ken title_snare = []
midi_channel(title_pipes, 0, 109, 70, 32)
midi_channel(title_harp, 1, 46, 79, 45)
midi_channel(title_fiddle, 2, 110, 69, 38)
midi_channel(title_drone, 3, 42, 61, 30)
midi_channel(title_snare, 9, 0, 48, 16)

fer pass in 0..2 {
    ken base = pass * 24 * 1920
    fer bar in 0..24 {
        ken t = base + bar * 1920
        ken middle = bar >= 8 an bar < 16
        gin middle {
            mak_siccar midi_bar(title_fiddle, 2, t, title_tune[bar], 62 + bar % 3) == 1920
        } ither {
            mak_siccar midi_bar(title_pipes, 0, t, title_tune[bar], 63 + bar % 4, 93) == 1920
        }
        # A low, bowed ground. Brief releases keep a real breath at cadences.
        midi_note(title_drone, 3, t, 1810, title_roots[bar], 46 + bar % 3)
        gin bar % 4 == 0 { midi_note(title_drone, 3, t, 1660, 45, 31) }
        ken chord = title_chords[bar % 8]
        # Off-beat harp steps, with fewer notes at every fourth-bar cadence.
        midi_note(title_harp, 1, t + 240, 690, chord[0] - 12, 49)
        midi_note(title_harp, 1, t + 720, 620, chord[1], 42)
        gin bar % 4 != 3 {
            midi_note(title_harp, 1, t + 1200, 650, chord[2], 45)
        }
        # Little low fiddle asides: the comic raised eyebrow, never a high alarm.
        gin nae middle an bar % 4 == 3 {
            midi_note(title_fiddle, 2, t + 1200, 180, 57, 47)
            midi_note(title_fiddle, 2, t + 1440, 180, 60, 44)
        }
        gin bar % 2 == 0 {
            midi_note(title_snare, 9, t + 480, 90, 38, 31)
            midi_note(title_snare, 9, t + 1440, 90, 38, 26)
        }
        gin bar % 8 == 6 {
            midi_note(title_snare, 9, t + 1680, 65, 38, 23)
            midi_note(title_snare, 9, t + 1800, 65, 38, 19)
        }
    }
}
midi_write("games/bogle/music/title.mid", [title_pipes,title_harp,title_fiddle,title_drone,title_snare], 800000, 4, 2, 92160)
blether "Braw: title.mid — twa passes o' 76.8 seconds"
