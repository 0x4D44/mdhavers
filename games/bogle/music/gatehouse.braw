# The Porter's Other Key — original sneaking jig for Bogle Castle E1M1.
# D dorian, 6/8, quarter = 120 (dotted-quarter = 80).
# Six eight-bar conversations, 48 bars = 72 seconds; two full passes for baking.
fetch "games/bogle/music/midi"

# Four related but distinct eight-bar strains. Durations are eighth-notes.
ken gate_strains = [
    [
        [[62,1],[65,1],[69,1],[67,2],[64,1]],
        [[65,1],[62,2],[60,1],[0,2]],
        [[62,2],[69,1],[71,1],[69,1],[65,1]],
        [[67,1],[64,1],[60,1],[62,2],[0,1]],
        [[65,1],[69,1],[72,1],[71,2],[67,1]],
        [[69,2],[65,1],[64,1],[0,2]],
        [[60,1],[64,1],[67,1],[65,1],[64,1],[60,1]],
        [[62,3],[0,3]]
    ],
    [
        [[69,2],[67,1],[65,1],[62,1],[64,1]],
        [[65,2],[69,1],[67,2],[0,1]],
        [[71,1],[69,1],[67,1],[64,2],[62,1]],
        [[60,2],[64,1],[62,2],[0,1]],
        [[67,1],[69,1],[72,1],[69,1],[65,1],[62,1]],
        [[64,1],[67,2],[65,1],[0,2]],
        [[60,1],[62,1],[65,1],[64,2],[60,1]],
        [[62,2],[57,1],[0,3]]
    ],
    [
        [[62,2],[0,1],[65,1],[64,1],[62,1]],
        [[60,1],[62,2],[0,3]],
        [[67,2],[65,1],[64,2],[60,1]],
        [[62,3],[0,3]],
        [[65,2],[0,1],[69,1],[67,1],[65,1]],
        [[64,1],[60,2],[0,3]],
        [[60,1],[64,1],[65,1],[67,1],[64,1],[60,1]],
        [[62,2],[0,4]]
    ],
    [
        [[65,1],[62,1],[64,1],[69,2],[67,1]],
        [[65,2],[64,1],[62,2],[0,1]],
        [[71,1],[67,1],[69,1],[65,2],[64,1]],
        [[60,1],[64,1],[67,1],[62,2],[0,1]],
        [[69,1],[72,1],[74,1],[71,1],[69,1],[67,1]],
        [[65,2],[69,1],[64,1],[0,2]],
        [[60,1],[64,1],[67,1],[65,1],[62,1],[60,1]],
        [[62,2],[60,1],[57,1],[0,2]]
    ]
]
ken gate_plan = [0,1,2,0,3,1]
ken gate_roots = [38,38,43,38,41,36,36,38]
ken gate_fiddle = []
ken gate_whistle = []
ken gate_bass = []
ken gate_harp = []
ken gate_pipes = []
ken gate_drum = []
midi_channel(gate_fiddle, 0, 110, 73, 29)
midi_channel(gate_whistle, 1, 78, 62, 35)
midi_channel(gate_bass, 2, 42, 73, 23)
midi_channel(gate_harp, 3, 46, 66, 31)
midi_channel(gate_pipes, 4, 109, 55, 27)
midi_channel(gate_drum, 9, 0, 64, 14)

fer pass in 0..2 {
    ken base = pass * 48 * 1440
    fer section in 0..6 {
        ken strain = gate_strains[gate_plan[section]]
        fer bar in 0..8 {
            ken t = base + (section * 8 + bar) * 1440
            # Trade whole phrases instead of doubling the entire tune.
            gin (section + bar / 4) % 2 == 0 {
                mak_siccar midi_bar(gate_fiddle, 0, t, strain[bar], 65 + bar % 3, 78) == 1440
            } ither {
                mak_siccar midi_bar(gate_whistle, 1, t, strain[bar], 60 + bar % 3, 79) == 1440
            }
            ken root = gate_roots[bar]
            midi_note(gate_bass, 2, t, 510, root, 52 + section % 3)
            gin bar % 4 != 3 {
                midi_note(gate_bass, 2, t + 720, 450, root + 7, 43)
            }
            # Drier, low toms suggest bodhran skins; no hats or crash loop.
            midi_note(gate_drum, 9, t, 105, 41, 48 + bar % 3)
            gin bar % 4 != 3 {
                midi_note(gate_drum, 9, t + 720, 90, 43, 38)
                gin bar % 2 == 0 { midi_note(gate_drum, 9, t + 1200, 75, 37, 26) }
            }
            # The quiet third section leaves more room for effects.
            gin section != 2 an bar % 2 == 1 {
                midi_note(gate_harp, 3, t + 240, 380, root + 24, 43)
                midi_note(gate_harp, 3, t + 960, 330, root + 31, 37)
            }
            # Two tiny pipe replies in the whole loop, below D5.
            gin (section == 1 or section == 4) an bar == 7 {
                midi_note(gate_pipes, 4, t + 720, 110, 67, 48)
                midi_note(gate_pipes, 4, t + 900, 110, 65, 46)
                midi_note(gate_pipes, 4, t + 1080, 210, 62, 44)
            }
        }
    }
}
midi_write("games/bogle/music/gatehouse.mid", [gate_fiddle,gate_whistle,gate_bass,gate_harp,gate_pipes,gate_drum], 500000, 6, 3, 138240)
blether "Braw: gatehouse.mid — twa passes o' 72 seconds"
