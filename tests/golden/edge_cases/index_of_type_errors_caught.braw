# index_of_type_errors_caught.braw - index_of type errors are catchable (no segfaults)

hae_a_bash {
    blether index_of("hello", 1)
} gin_it_gangs_wrang err {
    blether "caught_needle"
}

hae_a_bash {
    blether index_of(42, 1)
} gin_it_gangs_wrang err {
    blether "caught_container"
}

blether "done"

