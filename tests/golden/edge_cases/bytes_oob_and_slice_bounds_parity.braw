# bytes_oob_and_slice_bounds_parity.braw - bytes_get/bytes_set should be catchable on OOB and bytes_slice should clamp safely

ken b = bytes(3)
bytes_set(b, 0, 1)
bytes_set(b, 1, 2)
bytes_set(b, 2, 3)

blether bytes_len(b)
blether bytes_get(b, 0)
blether bytes_get(b, -1)

# start > len should return empty bytes (no crash)
blether bytes_len(bytes_slice(b, 99, 100))

# end < start should return empty bytes (no crash)
blether bytes_len(bytes_slice(b, 2, 1))

# Negative end should work
blether bytes_len(bytes_slice(b, 0, -1))

hae_a_bash {
    blether bytes_get(b, 99)
} gin_it_gangs_wrang err {
    blether "caught_bytes_get_oob_pos"
}

hae_a_bash {
    blether bytes_get(b, -99)
} gin_it_gangs_wrang err {
    blether "caught_bytes_get_oob_neg"
}

hae_a_bash {
    blether bytes_set(b, 99, 1)
} gin_it_gangs_wrang err {
    blether "caught_bytes_set_oob"
}

hae_a_bash {
    blether bytes_set(b, 0, 999)
} gin_it_gangs_wrang err {
    blether "caught_bytes_set_range"
}

blether "done"

