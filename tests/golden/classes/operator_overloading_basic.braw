# operator_overloading_basic.braw - golden operator overloading for classes

kin NumBox {
    dae init(v) {
        masel.v = v
    }

    dae __pit_thegither__(that) {
        gie masel.v + that.v
    }

    dae __wee_er__(that) {
        gie masel.v < that.v
    }

    dae __same_as__(that) {
        gie masel.v == that.v
    }

    dae __differs_fae__(that) {
        gie masel.v != that.v
    }
}

ken a = NumBox(2)
ken b = NumBox(3)

blether a + b
blether a < b
blether a == NumBox(2)
blether a != b
blether a != NumBox(2)

