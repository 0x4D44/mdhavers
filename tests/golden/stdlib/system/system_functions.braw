# Test system functions
# SKIP_NATIVE - Uses native functions not available in LLVM backend

# Test env_get with known variable
ken path_val = env_get("PATH")
blether path_val != naething
blether len(path_val) > 0

# Test env_get with unknown variable
ken unknown = env_get("THIS_VAR_DOES_NOT_EXIST_XYZ123")
blether unknown == naething

# Test env_set and env_get
env_set("MDHAVERS_TEST_VAR", "test_value")
blether env_get("MDHAVERS_TEST_VAR")

# Test cwd (should return a non-empty string)
ken current_dir = cwd()
blether len(current_dir) > 0

# Test args (should return a list)
ken cli_args = args()
blether len(cli_args) >= 1

# Test shell with simple command
ken output = shell("echo hello")
blether contains(output, "hello")

# Test shell_status
ken status = shell_status("true")
blether status

ken fail_status = shell_status("false")
blether fail_status
