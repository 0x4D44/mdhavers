# SKIP_NATIVE
# Note: List operations not fully supported in native
dae find_max(arr) {
    gin len(arr) == 0 {
        gie naething
    }
    ken max_val = arr[0]
    ken i = 1
    whiles i < len(arr) {
        gin arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }
    gie max_val
}

blether find_max([3, 1, 4, 1, 5, 9, 2, 6])
blether find_max([1])
blether find_max([5, 4, 3, 2, 1])
