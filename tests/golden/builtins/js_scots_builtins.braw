# js_scots_builtins.braw - the Scots checks an' list oddments the JS backend lacked
# (MDH-BUG-FLU-00167). SKIP_WASM: the WASM backend hasnae got these builtins. Error
# paths an' the prelude's wee() are in tests/js_builtin_fixes.rs (the native wording differs).
blether stoater([3, 9, 2])
blether stoater(["a", "abc", "ab"])
blether dicht([1, 2, 999, 3], 2)
blether dicht([1, 2, 3], -1)
blether bonnie(3)
blether bonnie([1, "a"])
blether is_a(3, "integer")
blether is_a(3, "float")
blether is_a("x", "str")
blether is_a([1], "list")
blether is_a(naething, "naething")
blether braw(5)
blether braw(0)
blether braw("")
blether braw([1])
blether scottify("yes I know nothing about the house")
blether redd_up([1, naething, 2, naething])
blether sclaff([1, [2, 3], 4])
blether drookit([1, 2, 1])
blether drookit([1, 2, 3])
blether gallus(500)
blether gallus(5)
blether gallus("a very long string indeed, yes")
blether wrang_sort(3, "string")
blether wrang_sort(3, "integer")
blether scunner_check(3, "integer")
blether scunner_check(3, "string")
blether backside_forrit([1, 2, 3])
blether backside_forrit("abc")
blether och("no")
blether jings(1)
blether crivvens("x")
blether help_ma_boab(2.5)
blether numpty_check(naething)
blether numpty_check("")
